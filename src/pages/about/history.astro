---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import site from '../../lib/site';
import { thaiDate, parseDay } from '../../lib/format';
const opening = parseDay(site.opening_ceremony.date);
---
<BaseLayout
  title="ประวัติความเป็นมา"
  description="ประวัติตำหนักผู่โถวเจ้าแม่กวนอิม ถนนพุทธมณฑลสาย ๒ — ที่มาของชื่อ เหตุที่ประดิษฐานครบ ๓๓ ปาง องค์พระ และกำหนดพิธีเปิด"
  breadcrumbs={[
    { label: 'หน้าแรก', href: '/' },
    { label: 'เกี่ยวกับตำหนัก', href: '/about' },
    { label: 'ประวัติ', href: '/about/history' },
  ]}
>
  <PageHero
    eyebrow="เกี่ยวกับตำหนัก"
    title="ประวัติความเป็นมา"
    lede="ตำหนักใหม่ที่กำลังจะเปิด — เท่าที่ทราบตอนนี้ และสิ่งที่รอเติมจากผู้ก่อตั้ง"
    narrow
  />
  <section class="band">
    <div class="wrap wrap--narrow prose">
      <h2>ที่มาของชื่อ</h2>
      <p>
        "ผู่โถว" (普陀) มาจากเกาะ<strong>ผู่โถวซาน</strong> (普陀山) ในมณฑลเจ้อเจียง ประเทศจีน
        พุทธสถานที่ถือกันว่าเป็นที่พำนักของพระโพธิสัตว์กวนอิม และเป็นหนึ่งในสี่ภูเขาศักดิ์สิทธิ์
        ของพุทธศาสนามหายานจีน ชื่อนี้จึงบอกตั้งแต่แรกว่าตำหนักแห่งนี้อุทิศแด่พระกวนอิมโดยเฉพาะ
      </p>

      <h2>เหตุที่ประดิษฐานครบ ๓๓ ปาง</h2>
      <p>
        ในสัทธรรมปุณฑรีกสูตร บท<a href="/worship/prayers/pu-men-pin">ผู่เหมินผิ่น</a> พระกวนอิมทรงแสดงพระองค์
        ใน ๓๓ รูปกายตามแต่ผู้ร้องขอจะรับได้ ตำหนักแห่งนี้ตั้งใจให้ผู้มากราบได้เห็นหลักธรรมข้อนี้
        ด้วยตาตนเอง จึงประดิษฐานองค์เจ้าแม่กวนอิมให้ครบทั้งชุดในที่เดียว
        ซึ่งยังพบได้น้อยมากในประเทศไทย
      </p>

      <h2>องค์พระ</h2>
      <p>
        องค์เจ้าแม่กวนอิมทั้งชุดเป็น<strong>พระขาวเนื้อกระเบื้อง</strong>ตามแบบเต๋อฮั่ว (德化)
        เมืองที่มีชื่อเรื่องพระกวนอิมกระเบื้องขาวมาตั้งแต่ราชวงศ์หมิง แต่ละองค์มีท่าและฐานต่างกัน
        ตามลักษณะเฉพาะของปาง ปัจจุบันอัญเชิญมาแล้ว ๒๙ องค์ อีก ๔ ปางอยู่ระหว่างดำเนินการ
        ดูองค์จริงได้ที่<a href="/gallery">ประมวลภาพ</a>
      </p>

      <h2>ที่ตั้งและกำหนดเปิด</h2>
      <p>
        ตำหนักตั้งอยู่ที่ {site.address.full_th} ริมถนนพุทธมณฑลสาย ๒
        และกำหนด<a href="/opening">พิธีเปิดอย่างเป็นทางการ</a>ในวันที่ {thaiDate(opening)}
      </p>

      <div class="note note--lacquer">
        <p>
          <strong>ส่วนที่รอจากผู้ก่อตั้ง</strong>{' '}
          ปีที่เริ่มก่อสร้าง · ผู้ริเริ่มและผู้อุปถัมภ์ · เหตุการณ์สำคัญระหว่างการก่อสร้าง ·
          ที่มาของการอัญเชิญองค์พระ — ได้ข้อมูลเมื่อไรจะเติมลงหน้านี้ทันที
          ผู้ดูแลส่งได้ที่<a href="/contact">หน้าติดต่อ</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose h2 { font-size: 21px; margin: 34px 0 10px; }
  .prose h2:first-child { margin-top: 0; }
  .prose p { color: var(--ink-2); }
  .note { margin-top: 36px; }
</style>
