---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { thaiDate, isoDate } from '../../lib/format';
import { ARTICLE_CATEGORY_LABEL, type ArticleCategory } from '../../lib/articles';

// เรียงหมวดตามลำดับที่คนมาครั้งแรกต้องการ — ไหว้อย่างไรมาก่อน ประวัติมาหลัง
const ORDER: ArticleCategory[] = ['worship', 'pang', 'days', 'shrine'];
const all = (await getCollection('articles')).sort((a, b) => +b.data.date - +a.data.date);
const groups = ORDER
  .map((c) => ({ c, label: ARTICLE_CATEGORY_LABEL[c], list: all.filter((a) => a.data.category === c) }))
  .filter((g) => g.list.length > 0);
---
<BaseLayout
  title="บทความ"
  description="คำถามที่ผู้มาตำหนักผู่โถวเจ้าแม่กวนอิมถามบ่อย ตอบทีละเรื่อง — ไหว้ครั้งแรกต้องเตรียมอะไร ของไหว้อะไรถวายได้ พูดขอพรอย่างไร แก้บนอย่างไร"
  breadcrumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'บทความ', href: '/articles' }]}
>
  <PageHero
    eyebrow="บทความ"
    title="ถามบ่อย ตอบทีละเรื่อง"
    lede="หนึ่งบทความตอบหนึ่งคำถาม เขียนตามที่ตำหนักผู่โถวปฏิบัติจริง และบอกชัดเมื่อข้อใดเป็นธรรมเนียมทั่วไปที่ไม่ใช่ข้อกำหนดของตำหนัก"
    narrow
  />
  <section class="band">
    <div class="wrap wrap--narrow">
      {groups.length === 0 && <p class="muted">ยังไม่มีบทความ</p>}
      {groups.map((g) => (
        <section class="group" id={g.c}>
          <h2 class="group__h">{g.label}</h2>
          <ul class="list">
            {g.list.map((a) => (
              <li>
                <a href={`/articles/${a.id}`}>
                  <span class="list__t">
                    {a.data.title}
                    {!a.data.verified_by && <span class="list__tag">รอตรวจสอบ</span>}
                  </span>
                  <span class="list__s">{a.data.summary}</span>
                  <time class="mono list__d" datetime={isoDate(a.data.updated ?? a.data.date)}>
                    {a.data.updated ? 'ปรับปรุง ' : ''}{thaiDate(a.data.updated ?? a.data.date, 'short')}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="more">ยังไม่พบคำตอบที่ต้องการ ดู<a href="/faq">คำถามที่พบบ่อย</a> หรือ<a href="/contact">ติดต่อตำหนัก</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .group + .group { margin-top: 48px; }
  .group__h { font-size: var(--fs-h3); margin-bottom: 10px; }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { border-top: 1px solid var(--line); }
  .list li:last-child { border-bottom: 1px solid var(--line); }
  .list a { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; text-decoration: none; color: inherit; }
  .list a:hover .list__t { color: var(--lacquer); }
  .list__t { font-family: var(--serif); font-size: var(--fs-h4); font-weight: 600; line-height: 1.45; }
  .list__tag { display: inline-block; margin-left: 10px; padding: 1px 9px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); font-family: var(--sans); font-size: var(--fs-caption); font-weight: 400; color: var(--ink-3); vertical-align: middle; }
  .list__s { font-size: var(--fs-md); color: var(--ink-2); line-height: 1.65; max-width: var(--measure); }
  .list__d { font-size: var(--fs-sm); color: var(--ink-3); }
  .more { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--ink-2); }
</style>
