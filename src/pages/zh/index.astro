---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoursBar from '../../components/HoursBar.astro';
import PangCard from '../../components/PangCard.astro';
import VisitPanel from '../../components/VisitPanel.astro';
import VideoBand from '../../components/VideoBand.astro';
import ShrinePhoto from '../../components/ShrinePhoto.astro';
import photos from '../../data/photos.json';
import site from '../../lib/site';
import { allPang, enshrinedCount } from '../../lib/pang';
import { getCollection } from 'astro:content';
import { daysFromToday, parseDay, isoDate } from '../../lib/format';

const lang = 'zh' as const;
const pang = await allPang();
const count = enshrinedCount(pang);

// หน้าแรกโชว์ ๘ องค์ หนึ่งองค์ต่อหนึ่งหมวดพร เหมือนหน้าไทย — โชว์ครบ ๓๓ ทำให้
// หน้าแรกยาวหมื่นพิกเซลและหนักเกินไป ตารางเต็มอยู่ที่ /zh/33-pang
const wishes = (await getCollection('wishes')).sort((a, b) => a.data.order - b.data.order);
const featured: typeof pang = [];
for (const w of wishes) {
  const pick = pang.find((p) => p.data.wishes.includes(w.data.id) && !featured.includes(p));
  if (pick) featured.push(pick);
}

const events = (await getCollection('events')).sort((a, b) => +a.data.date - +b.data.date);
const upcoming = events.filter((e) => daysFromToday(e.data.end_date ?? e.data.date) >= 0).slice(0, 3);

const o = site.opening_ceremony;
const openingDate = parseDay(o.date);
const daysToOpening = daysFromToday(openingDate);
const preOpening = o.active && daysToOpening >= 0;
const zhDate = (d: Date) => `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;

const hasFacade = 'shrine-exterior' in (photos.images as Record<string, unknown>);
---
<BaseLayout
  lang={lang}
  title="普陀觀音堂 — 三十三觀音 · 曼谷佛城二段"
  suffix={false}
  description="供奉觀音菩薩三十三法相的道場，位於曼谷佛城二段路。三十三法相之名號、辨識標記與要旨，開放時間與交通資訊。"
>
  <!-- 首屏即正面外觀，匾額、引言與按鈕疊在照片之上
       主要行動只有一個：導航前往本堂
       開光倒數在寬螢幕為右上角小牌，在手機為照片下方整條 -->
  <section class:list={['hero hero--home zone-gilt', hasFacade && 'hero--photo']}>
    <div class="hero__stage">
      {hasFacade && (
        <div class="hero__photo">
          <ShrinePhoto
            name="shrine-exterior"
            alt={`${site.name_zh} 正面`}
            ratio="1086 / 772" sizes="100vw" priority
          />
          <span class="hero__scrim" aria-hidden="true"></span>
        </div>
      )}
      <div class="wrap hero__inner">
        <div class="plaque-board fret hero__plaque">
          <span class="plaque-board__prefix han">佛城二段</span>
          <h1 class="plaque-board__zh han foil foil--live">{site.name_zh}</h1>
          <span class="plaque-board__th han">觀音菩薩三十三法相</span>
        </div>

        <p class="hero__lede han">{site.tagline_zh}</p>

        <div class="hero__cta">
          <a class="btn btn--gold hero__btn han" href={site.maps_url} target="_blank" rel="noopener">
            導航前往本堂 <span class="hero__btn-caret" aria-hidden="true">›</span>
          </a>
          <a class="btn hero__btn hero__btn--outline han" href="/zh/33-pang">三十三觀音</a>
        </div>
      </div>
    </div>

    {preOpening && (
      <a class="hero__ribbon" href="/zh/opening">
        <span class="hero__ribbon-label han">開光大典</span>
        <span class="hero__ribbon-date han">{openingDate.getUTCMonth() + 1}月{openingDate.getUTCDate()}日</span>
        {daysToOpening > 0 && <span class="hero__ribbon-count mono">尚餘 {daysToOpening} 天</span>}
      </a>
    )}
  </section>

  <HoursBar lang={lang} />

  <section class="band">
    <div class="wrap">
      <div class="intro">
        <div class="intro__text">
          <p class="eyebrow eyebrow--marked">本堂緣起</p>
          <h2>何謂三十三觀音</h2>
          <p>
            《妙法蓮華經・觀世音菩薩普門品》說，觀世音菩薩應以何身得度者，即現何身而為說法。
            此中要旨不在數目，而在<strong>慈悲隨眾生根機而調整接引之道</strong>。
          </p>
          <p>
            後世畫像與造像依此數目與觀念，逐漸集成三十三種法相，各有所持之物、姿態與意涵。
            「普陀」二字取自浙江普陀山——中國最大的觀音道場。本堂以此為名，
            並發願迎請三十三法相俱全。
          </p>
          <p class="intro__status mono">
            已安奉 {count.enshrined} 尊
            {count.pending > 0 && <> · 尚待迎請 {count.pending} 尊</>}
          </p>
          <p><a class="btn btn--ghost" href="/zh/33-pang">瀏覽三十三觀音</a></p>
        </div>

        <aside class="intro__aside panel">
          <h3>語言說明</h3>
          <p class="small">
            本站主體為泰文。中文版涵蓋來訪所需的資訊——本堂簡介、三十三法相、
            參拜方式、開放時間與交通、節日曆。
          </p>
          <p class="small">
            各尊的長篇考釋、堂內公告與祈願分類目前僅有泰文版，
            頁面上會標示並附上泰文連結。
          </p>
          <p><a class="btn btn--ghost" href="/">切換至泰文版</a></p>
        </aside>
      </div>
    </div>
  </section>

  <section class="band zone-hall featured">
    <div class="wrap featured__inner">
      <div class="section-head featured__head">
        <p class="eyebrow eyebrow--marked">一 — 三十三</p>
        <h2>堂內所奉觀音法相</h2>
      </div>
      <a class="btn btn--ghost featured__more han" href="/zh/33-pang">
        查看全部三十三尊 <span aria-hidden="true">›</span>
      </a>
      <div class="pang-grid pang-grid--eight">
        {featured.map((p, i) => <PangCard pang={p} priority={i < 4} lang={lang} />)}
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="band">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div>
            <p class="eyebrow eyebrow--marked">節日曆</p>
            <h2>近期重要日子</h2>
          </div>
          <a class="btn btn--ghost" href="/zh/calendar">完整節日曆</a>
        </div>
        <ol class="evt">
          {upcoming.map((e) => {
            const n = daysFromToday(e.data.date);
            return (
              <li class="evt__row">
                <time class="evt__date mono" datetime={isoDate(e.data.date)}>
                  {zhDate(e.data.date)}
                  {e.data.approx && <abbr class="evt__approx" title="依農曆推算，尚待堂方核對">≈</abbr>}
                </time>
                <span class="evt__title han">{e.data.title_zh || e.data.title}</span>
                <span class="evt__rel mono">{n === 0 ? '今日' : n === 1 ? '明日' : `尚餘 ${n} 天`}</span>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  <VideoBand lang={lang} />

  <section class="band band--sunk">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow--marked">交通</p>
        <h2>本堂位置</h2>
      </div>
      <VisitPanel lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .band--sunk { background: var(--surface-2); }
  .band--sunk + .band, .band + .band--sunk { border-top: 0; }
  .section-head--row { flex-direction: row; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; }

  .intro { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, 1fr); gap: 36px 48px; align-items: start; }
  .intro__text > * + * { margin-top: 16px; }
  .intro__text h2 { margin-top: 8px; }
  .intro__text p { line-height: 1.9; }
  .intro__status { font-size: var(--fs-sm); color: var(--celadon); }
  .intro__aside { padding: 22px; border-top: 3px solid var(--gold-bright); }
  .intro__aside h3 { font-size: var(--fs-h4); margin-bottom: 10px; }
  .intro__aside .small { color: var(--ink-2); line-height: 1.85; }
  .intro__aside .small + .small { margin-top: 10px; }
  .intro__aside p:last-child { margin-top: 16px; }
  @media (max-width: 759px) { .intro { grid-template-columns: 1fr; } }


  .evt { list-style: none; margin: 0; padding: 0; }
  .evt__row { display: grid; grid-template-columns: 190px 1fr auto; gap: 6px 20px; align-items: baseline; padding: 15px 0; border-top: 1px solid var(--line); }
  .evt__row:last-child { border-bottom: 1px solid var(--line); }
  .evt__date { font-size: var(--fs-sm); white-space: nowrap; }
  .evt__approx { color: var(--gold); text-decoration: none; margin-left: 4px; cursor: help; }
  .evt__title { font-size: var(--fs-md); }
  .evt__rel { font-size: var(--fs-label); color: var(--ink-3); white-space: nowrap; }
  @media (max-width: 759px) { .evt__row { grid-template-columns: 1fr auto; } .evt__date { grid-column: 1 / -1; } }
</style>
