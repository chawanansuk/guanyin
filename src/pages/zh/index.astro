---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoursBar from '../../components/HoursBar.astro';
import PangCard from '../../components/PangCard.astro';
import VisitPanel from '../../components/VisitPanel.astro';
import VideoBand from '../../components/VideoBand.astro';
import ShrinePhoto from '../../components/ShrinePhoto.astro';
import photos from '../../data/photos.json';
import site from '../../lib/site';
import { allPang, enshrinedCount } from '../../lib/pang';
import { getCollection } from 'astro:content';
import { daysFromToday, parseDay, isoDate } from '../../lib/format';

const lang = 'zh' as const;
const pang = await allPang();
const count = enshrinedCount(pang);

const events = (await getCollection('events')).sort((a, b) => +a.data.date - +b.data.date);
const upcoming = events.filter((e) => daysFromToday(e.data.end_date ?? e.data.date) >= 0).slice(0, 3);

const o = site.opening_ceremony;
const openingDate = parseDay(o.date);
const daysToOpening = daysFromToday(openingDate);
const preOpening = o.active && daysToOpening >= 0;
const zhDate = (d: Date) => `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;

const hasFacade = 'shrine-exterior' in (photos.images as Record<string, unknown>);
---
<BaseLayout
  lang={lang}
  title="普陀觀音堂 — 三十三觀音 · 曼谷佛城二段"
  suffix={false}
  description="供奉觀音菩薩三十三法相的道場，位於曼谷佛城二段路。三十三法相之名號、辨識標記與要旨，開放時間與交通資訊。"
>
  <section class:list={['hero zone-gilt', hasFacade && 'hero--photo']}>
    {hasFacade && (
      <div class="hero__photo">
        <ShrinePhoto
          name="shrine-exterior"
          alt={`${site.name_zh} 正面`}
          ratio="1086 / 772" sizes="100vw" priority
        />
      </div>
    )}
    <div class="wrap hero__inner">
      <div class="plaque-board hero__plaque">
        <span class="plaque-board__prefix han">佛城二段</span>
        <h1 class="plaque-board__zh han foil foil--live">{site.name_zh}</h1>
        <span class="plaque-board__th han">觀音菩薩三十三法相</span>
      </div>

      <p class="hero__where han">
        <span class="hero__where-zh">{site.motto_zh}</span>
        <span class="hero__where-sep" aria-hidden="true">·</span>
        <span>曼谷 佛城二段路</span>
      </p>
      <p class="hero__lede">{site.tagline_zh}</p>

      <div class="hero__cta">
        {preOpening ? (
          <>
            <a class="btn btn--plaque hero__btn" href="/zh/opening">
              <span>開光大典 {openingDate.getUTCMonth() + 1}月{openingDate.getUTCDate()}日</span>
              {daysToOpening > 0 && <span class="hero__count mono">尚餘 {daysToOpening} 天</span>}
            </a>
            <a class="btn btn--ghost hero__btn" href="/zh/33-pang">三十三觀音</a>
          </>
        ) : (
          <>
            <a class="btn btn--plaque hero__btn" href="/zh/33-pang">瀏覽三十三觀音</a>
            <a class="btn btn--ghost hero__btn" href="/zh/worship/how-to">參拜方式</a>
          </>
        )}
      </div>
    </div>
  </section>

  <HoursBar lang={lang} />

  <section class="band">
    <div class="wrap">
      <div class="intro">
        <div class="intro__text">
          <p class="eyebrow eyebrow--marked">本堂緣起</p>
          <h2>何謂三十三觀音</h2>
          <p>
            《妙法蓮華經・觀世音菩薩普門品》說，觀世音菩薩應以何身得度者，即現何身而為說法。
            此中要旨不在數目，而在<strong>慈悲隨眾生根機而調整接引之道</strong>。
          </p>
          <p>
            後世畫像與造像依此數目與觀念，逐漸集成三十三種法相，各有所持之物、姿態與意涵。
            「普陀」二字取自浙江普陀山——中國最大的觀音道場。本堂以此為名，
            並發願迎請三十三法相俱全。
          </p>
          <p class="intro__status mono">
            已安奉 {count.enshrined} 尊
            {count.pending > 0 && <> · 尚待迎請 {count.pending} 尊</>}
          </p>
          <p><a class="btn btn--ghost" href="/zh/33-pang">瀏覽三十三觀音</a></p>
        </div>

        <aside class="intro__aside panel">
          <h3>語言說明</h3>
          <p class="small">
            本站主體為泰文。中文版涵蓋來訪所需的資訊——本堂簡介、三十三法相、
            參拜方式、開放時間與交通、節日曆。
          </p>
          <p class="small">
            各尊的長篇考釋、堂內公告與祈願分類目前僅有泰文版，
            頁面上會標示並附上泰文連結。
          </p>
          <p><a class="btn btn--ghost" href="/">切換至泰文版</a></p>
        </aside>
      </div>
    </div>
  </section>

  <section class="band band--sunk">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow--marked">一 — 三十三</p>
        <h2>堂內所奉觀音法相</h2>
      </div>
      <div class="pang-grid">
        {pang.map((p, i) => <PangCard pang={p} priority={i < 6} lang={lang} />)}
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="band">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div>
            <p class="eyebrow eyebrow--marked">節日曆</p>
            <h2>近期重要日子</h2>
          </div>
          <a class="btn btn--ghost" href="/zh/calendar">完整節日曆</a>
        </div>
        <ol class="evt">
          {upcoming.map((e) => {
            const n = daysFromToday(e.data.date);
            return (
              <li class="evt__row">
                <time class="evt__date mono" datetime={isoDate(e.data.date)}>
                  {zhDate(e.data.date)}
                  {e.data.approx && <abbr class="evt__approx" title="依農曆推算，尚待堂方核對">≈</abbr>}
                </time>
                <span class="evt__title han">{e.data.title_zh || e.data.title}</span>
                <span class="evt__rel mono">{n === 0 ? '今日' : n === 1 ? '明日' : `尚餘 ${n} 天`}</span>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  <VideoBand lang={lang} />

  <section class="band band--sunk">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow--marked">交通</p>
        <h2>本堂位置</h2>
      </div>
      <VisitPanel lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; }

  /* ภาพกับป้ายต้องซ้อนกัน ป้ายจึงยื่นขึ้นไปทับขอบล่างของภาพ
     ค่าลบนี้คือ "ความลึกที่ป้ายแขวนอยู่บนตัวอาคาร" */
  .hero { --hang: clamp(34px, 6vw, 52px); }

  /* มือถือ: ภาพเต็มขอบจอ ไม่มีกรอบ — จอเล็กทุกพิกเซลต้องเป็นภาพ ไม่ใช่ขอบ
     อาคารในภาพสูงเกือบเต็มเฟรม จึงไม่ครอปบน–ล่าง คุมด้วยความกว้างเสมอ */
  .hero__photo {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }
  .hero__photo :global(.shrine-photo) {
    width: 100%;
    aspect-ratio: 1086 / 772 !important;
  }
  /* จอกว้าง: ภาพจำกัดความกว้างและผูกกับความสูงจอ ให้ป้ายยังอยู่ในจอแรก
     กรอบเป็นเส้นทองบาง ๆ เส้นเดียวพอ กรอบหนา ๆ อ่านเป็นรูปในร้านขายกรอบ */
  @media (min-width: 720px) {
    .hero__photo {
      width: min(100% - 64px, 880px, 56vh * 1.407);
      margin-top: clamp(20px, 3.4vw, 36px);
    }
    .hero__photo :global(.shrine-photo) {
      border-radius: 2px;
      box-shadow: 0 0 0 1px rgba(134, 99, 18, .38), 0 22px 48px -22px rgba(90, 62, 20, .4);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 0 clamp(36px, 6vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* ไม่มีภาพ: ป้ายอยู่บนพื้นเปล่า ไม่ต้องยื่น */
  .hero:not(.hero--photo) .hero__inner { padding-top: clamp(44px, 8vw, 80px); }

  .hero__plaque {
    width: min(100% - 32px, 520px);
    margin-top: calc(-1 * var(--hang));
    /* ป้ายที่แขวนทับภาพต้องมีเงาตกลงบนภาพ ไม่งั้นดูเหมือนวางแปะ */
    box-shadow:
      0 1px 1px rgba(60, 8, 6, .3),
      0 8px 18px rgba(60, 8, 6, .26),
      0 28px 56px -18px rgba(60, 8, 6, .5),
      inset 0 1px 0 rgba(246, 227, 176, .22);
  }
  .hero--photo .hero__plaque { margin-top: calc(-1 * var(--hang)); }
  @media (min-width: 720px) {
    .hero__plaque { width: min(100% - 64px, 500px); padding-block: 22px 24px; }
    .hero__plaque :global(.plaque-board__zh) { font-size: clamp(34px, 4.6vw, 50px); }
  }

  .hero__where {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline;
    gap: 4px 12px;
    margin: 22px 0 0;
    font-family: var(--sans);
    font-size: clamp(13px, 1.7vw, 14.5px);
    font-weight: 600;
    letter-spacing: .14em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .hero__where-zh { letter-spacing: .3em; padding-left: .3em; }
  .hero__where-sep { opacity: .5; }

  /* ประโยคเดียว ตัวไม่มีเชิง ตัดบรรทัดให้สมดุล
     เซอริฟบางที่ 17px บนจอ Android จะสั่นและอ่านยาก */
  .hero__lede {
    margin: 14px 0 0;
    max-width: 30ch;
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(17px, 2.1vw, 19px);
    line-height: 1.7;
    color: var(--ink-2);
    text-wrap: balance;
  }

  /* ปุ่มสองปุ่มกว้างเท่ากันเสมอ ปุ่มกว้างไม่เท่ากันอ่านเป็นงานยังไม่เสร็จ */
  .hero__cta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: min(100%, 460px);
    margin-top: 26px;
  }
  .hero__btn { width: 100%; flex-direction: column; gap: 1px; padding-inline: 12px; line-height: 1.25; }
  .hero__count { font-size: 12.5px; font-weight: 500; opacity: .82; letter-spacing: .04em; }
  @media (max-width: 380px) { .hero__cta { grid-template-columns: 1fr; } }


  .hero__count { font-size: 14px; opacity: .85; margin-left: 4px; }

  .band--sunk { background: var(--surface-2); }
  .band--sunk + .band, .band + .band--sunk { border-top: 0; }
  .section-head--row { flex-direction: row; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; }

  .intro { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, 1fr); gap: 36px 48px; align-items: start; }
  .intro__text > * + * { margin-top: 16px; }
  .intro__text h2 { margin-top: 8px; }
  .intro__text p { line-height: 1.9; }
  .intro__status { font-size: 15px; color: var(--celadon); }
  .intro__aside { padding: 22px; border-top: 3px solid var(--gold-bright); }
  .intro__aside h3 { font-size: 19px; margin-bottom: 10px; }
  .intro__aside .small { color: var(--ink-2); line-height: 1.85; }
  .intro__aside .small + .small { margin-top: 10px; }
  .intro__aside p:last-child { margin-top: 16px; }
  @media (max-width: 780px) { .intro { grid-template-columns: 1fr; } }

  .pang-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(178px, 1fr)); gap: 1px; background: transparent; }
  @media (max-width: 420px) { .pang-grid { grid-template-columns: repeat(2, 1fr); } }

  .evt { list-style: none; margin: 0; padding: 0; }
  .evt__row { display: grid; grid-template-columns: 190px 1fr auto; gap: 6px 20px; align-items: baseline; padding: 15px 0; border-top: 1px solid var(--line); }
  .evt__row:last-child { border-bottom: 1px solid var(--line); }
  .evt__date { font-size: 15.5px; white-space: nowrap; }
  .evt__approx { color: var(--gold); text-decoration: none; margin-left: 4px; cursor: help; }
  .evt__title { font-size: 17px; }
  .evt__rel { font-size: 13.5px; color: var(--ink-3); white-space: nowrap; }
  @media (max-width: 620px) { .evt__row { grid-template-columns: 1fr auto; } .evt__date { grid-column: 1 / -1; } }
</style>
