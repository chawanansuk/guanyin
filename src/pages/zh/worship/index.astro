---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';

const lang = 'zh' as const;
const LINKS = [
  { href: '/zh/worship/how-to', title: '參拜方式', desc: '從出發前的準備，到逐一禮拜完畢——本堂不燃香燭。' },
  { href: '/zh/worship/by-wish', title: '求什麼，拜哪一尊', desc: '從正在祈求的事情著手，看看哪幾尊是人們常來禮拜的。' },
  { href: '/zh/worship/offerings', title: '供品與禁忌', desc: '水果、鮮花與各種供品，哪些適合帶來，哪些不宜。' },
  { href: '/zh/worship/prayers', title: '經咒', desc: '本堂所用的經咒與誦文。' },
  { href: '/zh/articles', title: '文章', desc: '初次前來者常問的問題，逐一解答——第一次來要準備什麼、如何說出祈願、如何還願。' },
];
---
<BaseLayout
  lang={lang}
  title="參拜與祈願"
  description="在普陀觀音堂如何禮拜觀世音菩薩：參拜步驟、供品、禁忌、經咒，以及依所求之事選擇法相。本堂不燃香燭。"
  breadcrumbs={[{ label: '首頁', href: '/zh' }, { label: '參拜', href: '/zh/worship' }]}
>
  <PageHero
    eyebrow="參拜與祈願"
    title="如何參拜，如何祈願"
    lede="每座廟堂各有自己的慣例。這幾頁依普陀觀音堂的實際做法撰寫，並非抄自他處——與他處最大的不同，是本堂不燃香燭。"
  />
  <section class="band">
    <div class="wrap">
      <ul class="cards">
        {LINKS.map((l) => (
          <li>
            <a href={l.href}>
              <span class="cards__title">{l.title}</span>
              <span class="cards__desc">{l.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .cards a { display: flex; flex-direction: column; gap: 7px; padding: 24px 22px; background: var(--surface); text-decoration: none; color: inherit; height: 100%; }
  .cards a:hover { background: var(--surface-2); }
  .cards a:hover .cards__title { color: var(--lacquer); }
  .cards__title { font-family: var(--serif); font-size: var(--fs-h4); font-weight: 600; }
  .cards__desc { font-size: var(--fs-md); color: var(--ink-2); line-height: 1.65; }
</style>
