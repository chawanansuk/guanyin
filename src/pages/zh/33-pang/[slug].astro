---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PangArt from '../../../components/PangArt.astro';
import photoMeta from '../../../data/photo-meta.json';
import ShareBar from '../../../components/ShareBar.astro';
import { getCollection, render } from 'astro:content';
import { allPang, prevPang, nextPang } from '../../../lib/pang';

export async function getStaticPaths() {
  const list = await allPang();
  const zh = await getCollection('pangZh');
  return list.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, index: i, list, zh: zh.find((z) => z.data.slug === entry.data.slug) },
  }));
}

const lang = 'zh' as const;
const { entry, index, list, zh } = Astro.props;
const d = entry.data;
const z = zh?.data;
const prev = prevPang(list, index);
const next = nextPang(list, index);
// 中文全文：由泰文版譯出，結構與泰文頁相同；缺檔時只顯示名號與圖像，並引導至泰文版
const Content = zh ? (await render(zh)).Content : null;
const marks = z?.marks ?? '';
const essence = z?.essence ?? '';
// 仍用示意圖的法相：本堂尚未確認有此尊，不顯示參拜位置與掃碼提示
const illustrated = (photoMeta.illustrations as string[]).includes(d.photo);
const path = `/zh/33-pang/${d.slug}`;
const thPath = `/33-pang/${d.slug}`;
const CN_NUM = ['〇','一','二','三','四','五','六','七','八','九','十'];
const cn = (n: number) => (n <= 10 ? CN_NUM[n] : n < 20 ? `十${CN_NUM[n - 10]}` : n === 20 ? '二十' : n < 30 ? `二十${CN_NUM[n - 20]}` : n === 30 ? '三十' : `三十${CN_NUM[n - 30]}`);
const paras = (s: string) => s.split(/\n{2,}/).map((x) => x.trim()).filter(Boolean);

// 祈求類別的中文名稱 —— 類別頁目前只有泰文版，故只列名稱不加連結
const WISH_ZH: Record<string, string> = {
  health: '健康', children: '求子', career: '事業學業', trade: '生意',
  love: '姻緣', travel: '出行平安', protection: '護佑', peace: '安心',
};
const wishes = d.wishes.map((w) => WISH_ZH[w]).filter(Boolean);

const bySlug = (slug: string) => list.find((p) => p.data.slug === slug);
const confused = (z?.confused_with ?? [])
  .map((c) => ({ p: bySlug(c.slug), note: c.note }))
  .filter((c) => c.p);
const shrineConfirmed = d.verified_by.trim() !== '';

const description = z
  ? `${d.name_zh}，三十三觀音第${cn(d.order)}尊。${marks}${essence ? `要旨：${essence}` : ''}曼谷普陀觀音堂。`
  : `${d.name_zh}，三十三觀音第${cn(d.order)}尊。曼谷普陀觀音堂。`;
---
<BaseLayout
  lang={lang}
  title={`${d.name_zh}`}
  description={description}
  schema={z && z.faq.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'zh-Hant',
    mainEntity: z.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }] : []}
  ogImage={`/og/pang-${String(d.order).padStart(2, '0')}.jpg`}
  breadcrumbs={[
    { label: '首頁', href: '/zh' },
    { label: '三十三觀音', href: '/zh/33-pang' },
    { label: d.name_zh, href: path },
  ]}
>
  {!illustrated && (
  <aside class="qr zone-gilt">
    <div class="wrap qr__inner">
      <p class="qr__head">您正站在這尊前嗎</p>
      <p class="qr__where">
        {d.shrine_point !== null
          ? <span>堂內第 <strong>{cn(d.shrine_point)}</strong> 位</span>
          : <span>本尊列於堂中三十三觀音之中</span>}
        <span class="qr__nosmoke"> · 本堂<strong>不燃香燭</strong>，合掌為禮</span>
      </p>
      {(z?.short_prayer || essence) && <p class="qr__pray">「{z?.short_prayer || essence}」</p>}
    </div>
  </aside>
  )}

  <article class="pang">
    <div class="wrap pang__grid">
      <div class="pang__art zone-hall">
        <PangArt
          photo={d.photo} order={d.order} nameTh={d.name_zh} nameZh={d.name_zh}
          enshrined={d.enshrined} priority sizes="(max-width: 820px) 92vw, 420px" lang={lang}
        />
        {illustrated && (
          <p class="pang__artnote">此為示意圖，非本堂實際供奉之聖像，僅供辨識法相之用，正式照片尚待拍攝。</p>
        )}
        {!d.enshrined && <p class="pang__pending">本尊尚待迎請安奉</p>}
      </div>

      <div class="pang__main">
        <p class="pang__no mono">{String(d.order).padStart(2, '0')} / 33</p>
        <h1 class="han">{d.name_zh}</h1>
        <p class="pang__names">
          <span class="pang__py">{d.name_pinyin}</span>
          {d.name_zh_variants.length > 0 && <span class="pang__var han">亦作 {d.name_zh_variants.join('、')}</span>}
        </p>

        {essence && (
          <p class="pang__essence">
            <span class="pang__essence-label">本願要旨</span>
            {essence}
          </p>
        )}

        {wishes.length > 0 && (
          <p class="pang__wishes">
            <span class="pang__metalabel">常見祈求</span>
            {wishes.map((w) => <span class="pang__wish">{w}</span>)}
          </p>
        )}

        {marks && (
          <section class="pang__sec">
            <h2>辨識標記</h2>
            <p>{marks}</p>
            <p class="pang__caveat small">此為常見的造像特徵，非硬性規定。各堂造像略有出入皆屬常事。</p>
          </section>
        )}

        {z && z.keypoints.length > 0 && (
          <section class="pang__sec">
            <h2>要點</h2>
            <ul class="keypoints">
              {z.keypoints.map((k) => <li>{k}</li>)}
            </ul>
          </section>
        )}

        {z?.how_to_ask && (
          <section class="pang__sec">
            <h2>
              如何向這尊祈願
              {!shrineConfirmed && <span class="pang__tag">尚待本堂確認</span>}
            </h2>
            {paras(z.how_to_ask).map((p) => <p>{p}</p>)}
            {z.short_prayer && <blockquote class="pang__prayer">「{z.short_prayer}」</blockquote>}
          </section>
        )}

        {Content ? (
          <section class="pang__sec">
            <h2>名號、典故與意涵</h2>
            <p class="pang__evidence">
              本節隨處標明何者出自經典或古籍，何者為歷代相傳的故事，何者是對今日生活的體會。
            </p>
            <div class="prose pang__story han-prose"><Content /></div>
          </section>
        ) : (
          <div class="note pang__thai">
            <p><strong>本尊的長篇考釋</strong>目前僅有泰文版。</p>
            <p><a href={thPath}>閱讀泰文全文 ›</a></p>
          </div>
        )}

        {confused.length > 0 && (
          <section class="pang__sec">
            <h2>容易混淆的法相</h2>
            <ul class="pang__rel">
              {confused.map(({ p, note }) => (
                <li>
                  <a href={`/zh/33-pang/${p!.data.slug}`}>
                    <span class="mono pang__rel-no">{String(p!.data.order).padStart(2, '0')}</span>
                    <span class="pang__rel-name han">{p!.data.name_zh}</span>
                  </a>
                  <p>{note}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {z && z.faq.length > 0 && (
          <section class="pang__sec">
            <h2>問答</h2>
            <dl class="pang__faq">
              {z.faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
            </dl>
          </section>
        )}

        <section class="pang__sec">
          <h2>泰文名稱</h2>
          <dl class="pang__names-dl">
            <dt>依形取名</dt><dd>{d.name_th}</dd>
            {d.name_th_scholarly && (<><dt>依義譯經</dt><dd>{d.name_th_scholarly}</dd></>)}
            {d.name_sanskrit && (<><dt>梵名</dt><dd>{d.name_sanskrit}</dd></>)}
          </dl>
        </section>

        {d.shrine_point !== null && !illustrated && (
          <section class="pang__sec">
            <h2>堂內位置</h2>
            <p>依參拜動線為第 {cn(d.shrine_point)} 位</p>
          </section>
        )}

        <section class="pang__sec pang__meta">
          {z && z.sources.length > 0 && (
            <div class="small">
              <span class="pang__metalabel">出處</span>
              <ol class="pang__src">{z.sources.map((s) => <li>{s}</li>)}</ol>
            </div>
          )}
          <p class="small">
            <span class="pang__metalabel">說明</span>
            {z
              ? <>本頁譯自泰文版，經文引句皆依 CBETA 電子佛典核對原文，譯文尚待本堂校訂。</>
              : <>本頁中文內容尚在整理中。</>}
            {' '}<a href={thPath}>泰文版 ›</a>
          </p>
        </section>

        <div class="pang__share">
          <ShareBar title={d.name_zh} path={path} lang="zh" />
        </div>
      </div>
    </div>

    <nav class="pang__nav zone-gilt" aria-label="上一尊與下一尊">
      <div class="wrap pang__nav-inner">
        <a class="pang__nav-link" href={`/zh/33-pang/${prev.data.slug}`}>
          <span class="pang__nav-dir">‹ 上一尊</span>
          <span class="pang__nav-name han">{prev.data.name_zh}</span>
        </a>
        <a class="pang__nav-all" href="/zh/33-pang">三十三觀音一覽</a>
        <a class="pang__nav-link pang__nav-link--next" href={`/zh/33-pang/${next.data.slug}`}>
          <span class="pang__nav-dir">下一尊 ›</span>
          <span class="pang__nav-name han">{next.data.name_zh}</span>
        </a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* แถบสำหรับคนที่สแกน QR ยืนอยู่หน้าองค์ — รักเข้มตัวทอง
     ของเดิมเป็นเขียวมิ้นต์ซึ่งหลุดจากระบบสองสีของเว็บ */
  /* แถบ "ยืนอยู่หน้าองค์นี้ใช่ไหม" — คนสแกน QR หน้าองค์จะเห็นแถบนี้ก่อน
     ขลิบทองบนล่างให้อ่านเป็นป้ายติดผนัง ไม่ใช่กล่องแจ้งเตือน */
  .qr { border-top: 1px solid var(--gold-bright); border-bottom: 1px solid var(--gold-bright); }
  .qr__inner { padding-block: 16px; display: flex; flex-direction: column; gap: 3px; }
  .qr__head { font: 600 var(--fs-caption)/1.4 var(--mono); letter-spacing: .12em; color: var(--gold); margin: 0; }
  .qr__where { margin: 4px 0 0; font-size: var(--fs-md); color: var(--ink); }
  .qr__nosmoke { color: var(--ink-2); }
  .qr__pray { margin: 5px 0 0; font-size: var(--fs-md); color: var(--ink-2); line-height: 1.8; }

  .pang__grid { display: grid; grid-template-columns: minmax(280px, 420px) minmax(0, 1fr); gap: 36px 48px; align-items: start; padding-block: clamp(28px, 5vw, 48px); }
  @media (max-width: 899px) { .pang__grid { grid-template-columns: 1fr; gap: 26px; padding-top: 0; } }
  .pang__art { position: sticky; top: 68px; }
  /* ภาพองค์บนหน้าปางคือภาพเดียวที่คนจ้องดูนาน จึงใส่กรอบทองลาย 回紋
     ในหน้ารวมไม่ใส่ เพราะการ์ด ๓๓ ใบที่มีกรอบทุกใบจะกลายเป็นลายพร่า */
  .pang__art :global(.pang-figure) {
    border: clamp(11px, 2.6vw, 15px) solid transparent;
    border-image: var(--fret-light) 26 round;
    box-shadow: var(--shadow-lift);
  }
  .pang__art :global(.pang-art) { box-shadow: 0 0 0 1px rgba(134, 99, 18, .3); }
  @media (max-width: 899px) { .pang__art { position: relative; top: auto; } }

  /* องค์พระตั้งอยู่ในหอ — พื้นเข้มชุดเดียวกับแถบ ๘ ปางหน้าแรก
     มีแค่ภาพกับป้ายสั้นอยู่บนพื้นมืด เนื้อหาให้อ่านยังอยู่บนพื้นครีมทั้งหมด */
  .pang__art.zone-hall { padding: var(--space-6); border: 1px solid var(--gold-line); overflow: hidden; }
  @media (max-width: 899px) {
    .pang__art.zone-hall {
      margin-inline: calc(-1 * var(--gutter));
      padding: var(--space-8) var(--gutter);
      border-inline: 0;
    }
  }
  .pang__artnote { margin: 10px 0 0; padding: 9px 12px; background: var(--surface-2); border-left: 3px solid var(--gold-line); font-size: var(--fs-sm); line-height: 1.75; color: var(--ink-3); }
  .pang__pending { margin: 10px 0 0; padding: 9px 12px; background: var(--surface-2); border-left: 3px solid var(--line-strong); font-size: var(--fs-sm); color: var(--ink-2); }

  .pang__no { font-size: var(--fs-label); color: var(--gold); letter-spacing: .12em; margin: 0 0 8px; }
  h1 { letter-spacing: .06em; }
  .pang__names { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin: 10px 0 0; }
  .pang__py { font-size: var(--fs-md); color: var(--ink-3); font-style: italic; }
  .pang__var { font-size: var(--fs-sm); color: var(--ink-3); }

  .pang__essence {
    margin: 20px 0 0; padding: 14px 16px;
    background: var(--gold-soft); border-left: 3px solid var(--gold);
    font-size: var(--fs-md); line-height: 1.85;
  }
  .pang__essence-label { display: block; font-family: var(--mono); font-size: var(--fs-caption); letter-spacing: .12em; color: var(--gold); margin-bottom: 4px; }

  .pang__sec { margin-top: 34px; }
  .pang__sec h2 { font-size: var(--fs-h4); padding-bottom: 7px; margin-bottom: 12px; border-bottom: 1px solid var(--line); }
  .pang__sec p { font-size: var(--fs-md); line-height: 1.85; }
  .pang__caveat { color: var(--ink-3); margin-top: 8px; }

  .pang__names-dl { display: grid; grid-template-columns: 92px 1fr; margin: 0; }
  .pang__names-dl dt { font-family: var(--mono); font-size: var(--fs-caption); letter-spacing: .08em; color: var(--ink-3); padding: 9px 0; border-top: 1px solid var(--line); }
  .pang__names-dl dd { margin: 0; padding: 9px 0; border-top: 1px solid var(--line); color: var(--ink-2); }

  .pang__thai { margin-top: 32px; }
  .pang__share { margin-top: 30px; padding-top: 22px; border-top: 1px solid var(--line); }

  .pang__nav { border-top: 1px solid var(--gold-line); }
  .pang__nav-inner { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px 24px; align-items: center; padding-block: 22px; }
  .pang__nav-link { display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: inherit; min-height: 44px; justify-content: center; }
  .pang__nav-link--next { text-align: right; }
  .pang__nav-dir { font-size: var(--fs-label); letter-spacing: .18em; text-transform: uppercase; color: var(--gold); }
  .pang__nav-name { font-family: var(--display); font-size: var(--fs-md); color: var(--ink-2); margin-top: 3px; transition: color .3s var(--ease-lux); }
  .pang__nav-link:hover .pang__nav-name { color: var(--lacquer); }
  .pang__nav-all { font-size: var(--fs-sm); white-space: nowrap; color: var(--gold); text-decoration: none; border-bottom: 1px solid var(--gold-line); padding-block: var(--space-3) 2px; min-height: 44px; display: inline-flex; align-items: flex-end; }
  @media (max-width: 559px) {
    .pang__nav-inner { grid-template-columns: 1fr 1fr; }
    .pang__nav-all { grid-column: 1 / -1; grid-row: 1; text-align: center; }
  }

  /* ---- 與泰文頁共用的全文區塊樣式 ---- */
  .pang__wishes { margin: 16px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
  .pang__wish { display: inline-block; padding: 2px 11px; border: 1px solid var(--gold-line); border-radius: var(--radius-pill); font-size: var(--fs-sm); color: var(--ink-2); background: var(--surface); }
  .keypoints { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .keypoints li { position: relative; padding-left: 26px; line-height: 1.8; font-size: var(--fs-md); }
  .keypoints li::before {
    content: ""; position: absolute; left: 2px; top: .66em; width: 9px; height: 9px;
    transform: rotate(45deg); background: var(--gold-bright); box-shadow: 0 0 0 1px rgba(134, 99, 18, .35);
  }
  .pang__tag {
    display: inline-block; margin-left: 10px; padding: 1px 9px;
    border: 1px solid var(--line-strong); border-radius: var(--radius-pill);
    font-family: var(--sans); font-size: var(--fs-caption); font-weight: 400;
    letter-spacing: 0; color: var(--ink-3); vertical-align: middle;
  }
  .pang__sec > p + p { margin-top: .8em; }
  .pang__prayer {
    margin: 16px 0 0; padding: 12px 18px; border-left: 3px solid var(--lacquer);
    font-family: var(--serif); font-size: var(--fs-h4); line-height: 1.7; color: var(--ink);
  }
  .pang__evidence { font-size: var(--fs-sm) !important; color: var(--ink-3); margin-bottom: 6px; }
  .pang__story :global(h3) { font-size: var(--fs-h4); margin-top: 1.6em; }
  .pang__story :global(p) { font-size: var(--fs-md); line-height: 1.95; }
  .pang__rel { list-style: none; margin: 8px 0 0; padding: 0; }
  .pang__rel li { border-top: 1px solid var(--line); padding: 4px 0 10px; }
  .pang__rel li:last-child { border-bottom: 1px solid var(--line); }
  .pang__rel a { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; min-height: 44px; padding-top: 10px; text-decoration: none; color: inherit; }
  .pang__rel a:hover .pang__rel-name { color: var(--lacquer); }
  .pang__rel-no { font-size: var(--fs-sm); color: var(--ink-3); }
  .pang__rel-name { font-family: var(--serif); font-size: var(--fs-h4); font-weight: 600; }
  .pang__rel p { margin: 2px 0 0; color: var(--ink-2); }
  .pang__faq { margin: 0; }
  .pang__faq dt { font-family: var(--serif); font-size: var(--fs-h4); font-weight: 600; margin-top: 18px; }
  .pang__faq dd { margin: 6px 0 0; color: var(--ink-2); font-size: var(--fs-md); line-height: 1.85; }
  .pang__meta { padding-top: 20px; border-top: 1px solid var(--line); }
  .pang__meta p { margin: 0; color: var(--ink-2); }
  .pang__meta > * + * { margin-top: 10px; }
  .pang__src { margin: 6px 0 0; padding-left: 1.5em; color: var(--ink-2); overflow-wrap: anywhere; }
  .pang__src li + li { margin-top: 6px; }
  .pang__metalabel {
    font-family: var(--mono); font-size: var(--fs-caption);
    letter-spacing: .1em; color: var(--ink-3); margin-right: 8px;
  }
</style>
