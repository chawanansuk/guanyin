---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { getCollection, render } from 'astro:content';
import { isoDate } from '../../../lib/format';
import { ARTICLE_CATEGORY_LABEL_ZH } from '../../../lib/articles';
import site from '../../../lib/site';

// 中文文章：文字取自 src/content/articles-zh/<slug>.md，
// 分類、日期、相關法相、祈求類別與校訂狀態一律取自泰文原文，兩邊不會不一致
export async function getStaticPaths() {
  const th = await getCollection('articles');
  const zh = await getCollection('articlesZh');
  return zh
    .map((z) => ({ z, t: th.find((a) => a.id === z.id) }))
    .filter((x) => x.t)
    .map(({ z, t }) => ({ params: { slug: z.id }, props: { z, t: t! } }));
}
const lang = 'zh' as const;
const { z, t } = Astro.props;
const { Content } = await render(z);
const d = t.data;
const zd = z.data;
const path = `/zh/articles/${z.id}`;
const ready = d.verified_by.trim() !== '';
const catLabel = ARTICLE_CATEGORY_LABEL_ZH[d.category];
const zhDate = (x: Date) => `${x.getUTCFullYear()}年${x.getUTCMonth() + 1}月${x.getUTCDate()}日`;

const pangAll = await getCollection('pang');
const pang = d.pang
  .map((slug) => pangAll.find((p) => p.data.slug === slug))
  .filter((p): p is NonNullable<typeof p> => !!p);
const wishAll = await getCollection('wishes');
const WISH_ZH: Record<string, string> = {
  health: '健康', children: '求子', career: '事業學業', trade: '生意',
  love: '姻緣', travel: '出行平安', protection: '護佑', peace: '安心',
};
const wishes = d.wishes
  .map((id) => wishAll.find((w) => w.data.id === id))
  .filter((w): w is NonNullable<typeof w> => !!w);

const thAll = await getCollection('articles');
const zhAll = await getCollection('articlesZh');
const same = (id: string) => (thAll.find((a) => a.id === id)?.data.category === d.category ? 0 : 1);
const dateOf = (id: string) => +(thAll.find((a) => a.id === id)?.data.date ?? 0);
const others = zhAll
  .filter((a) => a.id !== z.id && thAll.some((x) => x.id === a.id))
  .sort((a, b) => same(a.id) - same(b.id) || dateOf(b.id) - dateOf(a.id))
  .slice(0, 4);

const schema: unknown[] = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: zd.title,
  description: zd.summary,
  datePublished: isoDate(d.date),
  dateModified: isoDate(d.updated ?? d.date),
  inLanguage: 'zh-Hant',
  mainEntityOfPage: new URL(path, site.url).href,
  author: { '@type': 'Organization', name: site.name_zh, url: site.url },
  publisher: { '@type': 'Organization', name: site.name_zh, url: site.url },
}];
if (zd.faq.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'zh-Hant',
    mainEntity: zd.faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<BaseLayout
  lang={lang}
  title={zd.title}
  suffix={false}
  description={zd.summary}
  noindex={!ready}
  schema={schema}
  breadcrumbs={[
    { label: '首頁', href: '/zh' },
    { label: '文章', href: '/zh/articles' },
    { label: zd.title, href: path },
  ]}
>
  <PageHero eyebrow={`文章 · ${catLabel}`} title={zd.title} lede={zd.summary} narrow>
    <p class="date mono">
      <time datetime={isoDate(d.date)}>{zhDate(d.date)}</time>
      {d.updated && <span> · 更新於 <time datetime={isoDate(d.updated)}>{zhDate(d.updated)}</time></span>}
    </p>
  </PageHero>

  <section class="band">
    <div class="wrap wrap--narrow">
      {!ready && (
        <div class="note note--lacquer pending">
          <p><strong>尚待校訂</strong> 本文為初稿，待本堂執事確認與實際做法相符。涉及本堂慣例之處，日後可能修訂。</p>
        </div>
      )}

      <div class="prose han-prose"><Content /></div>

      {zd.faq.length > 0 && (
        <section class="faqsec">
          <h2>問答</h2>
          <dl class="faq">
            {zd.faq.map((f) => (<>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </>))}
          </dl>
        </section>
      )}

      {(pang.length > 0 || wishes.length > 0) && (
        <section class="rel">
          {pang.length > 0 && (
            <div>
              <p class="eyebrow eyebrow--marked">文中提到的法相</p>
              <ul class="rel__pang">
                {pang.map((p) => (
                  <li>
                    <a href={`/zh/33-pang/${p.data.slug}`}>
                      <span class="mono rel__no">{String(p.data.order).padStart(2, '0')}</span>
                      <span class="rel__name han">{p.data.name_zh}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {wishes.length > 0 && (
            <div>
              <p class="eyebrow eyebrow--marked">依祈求事項參拜</p>
              <ul class="chips">
                {wishes.map((w) => <li><a class="chip" href={`/zh/wish/${w.data.id}`}>{w.data.short_zh || WISH_ZH[w.data.id]}</a></li>)}
              </ul>
            </div>
          )}
        </section>
      )}

      {zd.sources.length > 0 && (
        <section class="src">
          <h2>參考資料</h2>
          <ul>{zd.sources.map((s) => <li>{s}</li>)}</ul>
        </section>
      )}

      <p class="verify mono">
        {ready ? `校訂：${d.verified_by}` : '尚未經本堂執事校訂'}
        {' · '}譯自<a href={`/articles/${z.id}`}>泰文版</a>
      </p>

      <div class="share"><ShareBar title={zd.title} path={path} lang="zh" /></div>

      {others.length > 0 && (
        <section class="others">
          <h2>其他文章</h2>
          <ul class="others__list">
            {others.map((a) => (
              <li><a href={`/zh/articles/${a.id}`}>{a.data.title}</a></li>
            ))}
          </ul>
          <p class="back"><a href="/zh/articles">‹ 全部文章</a></p>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .date { margin-top: 14px; font-size: var(--fs-sm); color: var(--ink-3); }
  .pending { margin-bottom: 30px; }
  .pending strong { color: var(--lacquer); }

  .faqsec { margin-top: 48px; }
  .faqsec h2, .src h2, .others h2 { font-size: var(--fs-h3); margin-bottom: 12px; }
  .faq { margin: 0; }
  .faq dt { font-family: var(--serif); font-size: var(--fs-h4); font-weight: 600; margin-top: 20px; }
  .faq dd { margin: 6px 0 0; color: var(--ink-2); max-width: var(--measure); line-height: 1.85; }

  .rel { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); display: grid; gap: 28px; }
  .rel__pang { list-style: none; margin: 10px 0 0; padding: 0; }
  .rel__pang li { border-top: 1px solid var(--line); }
  .rel__pang li:last-child { border-bottom: 1px solid var(--line); }
  .rel__pang a { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 12px 0; min-height: 44px; text-decoration: none; color: inherit; }
  .rel__pang a:hover .rel__name { color: var(--lacquer); }
  .rel__no { font-size: var(--fs-sm); color: var(--ink-3); }
  .rel__name { font-family: var(--serif); font-size: var(--fs-h4); font-weight: 600; }
  .rel__zh { font-size: var(--fs-md); color: var(--ink-3); }
  .rel .chips { margin-top: 10px; }

  .src { margin-top: 40px; }
  .src ul { margin: 0; padding-left: 1.2em; color: var(--ink-2); font-size: var(--fs-md); }
  .src li + li { margin-top: 6px; }
  .verify { margin-top: 28px; font-size: var(--fs-sm); color: var(--ink-3); }

  .share { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line); }
  .others { margin-top: 40px; }
  .others__list { list-style: none; margin: 0; padding: 0; }
  .others__list li { border-top: 1px solid var(--line); }
  .others__list li:last-child { border-bottom: 1px solid var(--line); }
  .others__list a { display: block; padding: 14px 0; min-height: 44px; font-family: var(--serif); font-weight: 600; text-decoration: none; color: inherit; }
  .others__list a:hover { color: var(--lacquer); }
  .back { margin-top: 24px; }
</style>
