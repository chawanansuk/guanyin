---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const FAQ = [
  { q: 'ตำหนักผู่โถวเจ้าแม่กวนอิมเปิดกี่โมง', a: 'เปิดทุกวัน จันทร์–ศุกร์ เวลา 10:00–15:00 น. เสาร์–อาทิตย์ 09:30–15:00 น. วันงานพิธีอาจขยายเวลา ดูประกาศที่หน้าปฏิทิน' },
  { q: 'ตำหนักอยู่ที่ไหน', a: 'เลขที่ 255/5 ถนนพุทธมณฑลสาย ๒ แขวงบางไผ่ เขตบางแค กรุงเทพมหานคร 10160 สังเกตป้ายอักษรจีน 普陀觀音堂 เหนือประตูทางเข้า' },
  { q: 'ที่ตำหนักจุดธูปเทียนได้ไหม', a: 'ไม่ได้ ตำหนักผู่โถวไม่จุดธูปและไม่จุดเทียน กราบด้วยการพนมมือถือว่าครบถ้วนแล้ว ไม่ต้องซื้อและไม่ต้องนำธูปเทียนมา' },
  { q: '๓๓ ปางคืออะไร', a: 'คือ ๓๓ รูปลักษณ์ที่พระโพธิสัตว์กวนอิมทรงแสดงตามแต่ผู้ร้องขอจะรับได้ ตามที่ปรากฏในสัทธรรมปุณฑรีกสูตร บทสมันตมุขปริวรรต แต่ละปางมีสิ่งที่ทรงถือและความหมายต่างกัน' },
  { q: 'ควรไหว้ปางไหนดี', a: 'เลือกจากเรื่องที่กำลังขอได้ที่หน้า “ขอพรเรื่องไหน ไหว้ปางใด” แต่ผู้ที่ศรัทธาปางใดเป็นพิเศษ ย่อมกราบไหว้ปางนั้นในทุกเรื่องได้' },
  { q: 'ต้องเตรียมของมาเองไหม', a: 'ไม่จำเป็น การมากราบไหว้โดยไม่มีเครื่องบูชาก็ทำได้ ถ้าประสงค์ถวาย ใช้ดอกไม้หรือผลไม้มงคลได้ แต่ไม่ต้องนำธูปเทียนมา เพราะตำหนักไม่จุดไฟ' },
  { q: 'ถวายเนื้อสัตว์ได้ไหม', a: 'ไม่ได้ เจ้าแม่กวนอิมทรงถือมังสวิรัติ เครื่องบูชาจึงเป็นของไม่มีเนื้อสัตว์ทั้งหมด รวมถึงไข่และอาหารที่ปรุงด้วยน้ำมันหมู' },
  { q: 'ถ่ายรูปในตำหนักได้ไหม', a: 'ถ่ายได้ตามปกติ แต่โปรดสอบถามเจ้าหน้าที่ก่อนถ่ายภาพระหว่างพิธี และไม่ปีนขึ้นบนฐานองค์พระ' },
  { q: 'มีที่จอดรถไหม', a: 'มีลานจอดรถภายในบริเวณตำหนัก ในวันงานพิธีอาจเต็ม แนะนำให้มาก่อนเวลา' },
  { q: 'วันสำคัญของเจ้าแม่กวนอิมมีวันไหนบ้าง', a: 'สามวันสำคัญคือ วันประสูติ (๑๙ ค่ำ เดือน ๒) วันตรัสรู้ (๑๙ ค่ำ เดือน ๖) และวันออกบวช (๑๙ ค่ำ เดือน ๙) ดูวันที่สากลของแต่ละปีได้ที่หน้าปฏิทิน' },
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}];
---
<BaseLayout
  title="คำถามที่พบบ่อย"
  description="เปิดกี่โมง อยู่ที่ไหน จุดธูปได้ไหม ถวายอะไรได้บ้าง — คำถามที่ผู้มาตำหนักผู่โถวเจ้าแม่กวนอิมถามบ่อยที่สุด"
  schema={schema}
  breadcrumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'คำถามที่พบบ่อย', href: '/faq' }]}
>
  <PageHero eyebrow="คำถามที่พบบ่อย" title="คำถามที่พบบ่อย" narrow />
  <section class="band">
    <div class="wrap wrap--narrow">
      <dl class="faq">
        {FAQ.map((f) => (<>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>))}
      </dl>
      <p class="more">ไม่พบคำตอบที่ต้องการ <a href="/contact">ติดต่อตำหนัก</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .faq { margin: 0; }
  .faq dt { font-family: var(--serif); font-size: 19px; font-weight: 600; padding-top: 24px; margin-top: 24px; border-top: 1px solid var(--line); }
  .faq dt:first-of-type { padding-top: 0; margin-top: 0; border-top: 0; }
  .faq dd { margin: 9px 0 0; color: var(--ink-2); max-width: var(--measure); }
  .more { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--ink-2); }
</style>
