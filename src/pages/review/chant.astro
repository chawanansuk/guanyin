---
// หน้าให้ผู้ดูแลตำหนักตรวจร่างบทสวดและเพลงประจำปาง ไม่ลิงก์จากเมนู และไม่ให้ Google เก็บ
// ตรวจแล้ว: ตั้ง status เป็น approved และกรอก reviewed_by ใน src/data/pang-chant.json ส่วนนั้นจึงขึ้นบนหน้าปาง
import BaseLayout from '../../layouts/BaseLayout.astro';
import PangChant from '../../components/PangChant.astro';
import chants from '../../data/pang-chant.json';
import { allPang, displayName } from '../../lib/pang';
import { pangNo } from '../../lib/format';

const list = await allPang();
const entries = list.filter((p) => p.data.slug in chants);
---
<BaseLayout title="ร่างบทสวดและเพลงประจำปาง" description="หน้าให้ผู้ดูแลตำหนักตรวจร่างบทสวดและเพลงประจำปาง" noindex>
  <main class="wrap review">
    <p class="eyebrow">สำหรับผู้ดูแลตำหนัก</p>
    <h1>ร่างบทสวดและเพลงประจำปาง</h1>
    <div class="note">
      <p>หน้านี้ไม่อยู่ในเมนู และไม่ส่งให้ Google รวมบทสวดและเพลงทั้ง ๓๓ ปางไว้ให้ตรวจในหน้าเดียว</p>
      <p>
        สิ่งที่ขอให้ตรวจ ๑) บทสรรเสริญภาษาไทยและภาษาจีนถูกต้องตามความหมายของปางและเหมาะจะสวดหรือไม่
        ๒) ตำหนักใช้บทดั้งเดิมฉบับใด ๓) เพลงบรรเลงเหมาะกับบรรยากาศตำหนักหรือไม่
        ส่วนนี้แสดงบนหน้าปางแล้ว พร้อมป้ายรอตำหนักยืนยัน ตรวจปางไหนแล้ว ให้กรอกชื่อผู้ตรวจ ป้ายจะหายไป
      </p>
    </div>
    <nav class="review__toc" aria-label="ไปที่ปาง">
      <ul>
        {entries.map((p) => (
          <li><a href={`#${p.data.slug}`}><span class="mono">{pangNo(p.data.order)}</span> {displayName(p)}</a></li>
        ))}
      </ul>
    </nav>
    {entries.map((p) => (
      <article class="review__item" id={p.data.slug}>
        <h2 class="review__pang">
          <span class="mono">{pangNo(p.data.order)}</span>
          <a href={`/33-pang/${p.data.slug}`}>{displayName(p)}</a>
          <span class="han">{p.data.name_zh}</span>
        </h2>
        <PangChant slug={p.data.slug} preview />
        <details class="review__zh">
          <summary>ดูแบบที่แสดงในโหมดภาษาจีน</summary>
          <PangChant slug={p.data.slug} lang="zh" preview />
        </details>
      </article>
    ))}
  </main>
</BaseLayout>

<style>
  .review { max-width: 760px; padding-block: clamp(32px, 6vw, 64px); }
  .review h1 { margin: 6px 0 16px; }
  .review .note p + p { margin-top: .6em; }
  .review__item { margin-top: 48px; scroll-margin-top: 80px; }
  .review__toc ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 8px; margin-top: 20px; }
  .review__toc a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px;
    border: 1px solid var(--line); border-radius: var(--radius-pill); background: var(--surface);
    font-size: var(--fs-sm); color: var(--ink-2); text-decoration: none;
  }
  .review__toc .mono { color: var(--gold); }
  .review__pang { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; font-size: var(--fs-h3); }
  .review__pang .mono { color: var(--gold); font-size: .7em; }
  .review__pang .han { color: var(--ink-3); font-size: .8em; }
  .review__zh { margin-top: 24px; }
  .review__zh summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--gold); }
</style>
