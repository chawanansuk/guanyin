---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursBar from '../components/HoursBar.astro';
import PangCard from '../components/PangCard.astro';
import EventList from '../components/EventList.astro';
import VisitPanel from '../components/VisitPanel.astro';
import ShrinePhoto from '../components/ShrinePhoto.astro';
import VideoBand from '../components/VideoBand.astro';
import photos from '../data/photos.json';
import site from '../lib/site';
import { allPang, enshrinedCount } from '../lib/pang';
import { getCollection } from 'astro:content';
import { thaiDate, daysFromToday, isoDate, parseDay } from '../lib/format';

const pang = await allPang();
const count = enshrinedCount(pang);

const wishes = (await getCollection('wishes')).sort((a, b) => a.data.order - b.data.order);
// หน้าแรกโชว์ ๘ องค์ หนึ่งองค์ต่อหนึ่งหมวดพร ไม่ใช่เรียงเลข ๑–๘
// เพราะต้องการให้เห็นความหลากหลายของชุด ไม่ใช่จุดเริ่มของลำดับ
const featured: typeof pang = [];
for (const w of wishes) {
  const pick = pang.find((p) => p.data.wishes.includes(w.data.id) && !featured.includes(p));
  if (pick) featured.push(pick);
}

const events = (await getCollection('events')).sort((a, b) => +a.data.date - +b.data.date);
const upcoming = events.filter((e) => daysFromToday(e.data.end_date ?? e.data.date) >= 0).slice(0, 3);

const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
const staleMs = site.content.news_stale_months * 30 * 86_400_000;
// ถ้าไม่มีใครลงข่าวนาน ๆ ให้ซ่อนส่วนข่าวไปเลย ดีกว่าโชว์ข่าวเก่าค้างปี
const freshNews = news.filter((n) => Date.now() - +n.data.date < staleMs).slice(0, 3);

const opening = site.opening_ceremony;
const openingDate = parseDay(opening.date);
const daysToOpening = daysFromToday(openingDate);
// ก่อนวันงาน หน้าแรกพูดเรื่องพิธีเปิดเป็นอย่างแรก — หลังวันงานสลับกลับเองตอน rebuild รายวัน
const preOpening = opening.active && daysToOpening >= 0;

// มีภาพหน้าอาคารแล้วหรือยัง — ถ้ามี ฮีโร่จะเป็นภาพจริง ถ้ายังไม่มีก็เป็นป้ายแดงทองแทน
const hasFacade = 'shrine-exterior' in (photos.images as Record<string, unknown>);

const schema = preOpening
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: opening.headline,
      startDate: opening.date,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@id': `${site.url}/#shrine` },
      url: `${site.url}/opening`,
      organizer: { '@type': 'Organization', name: site.name_th, url: site.url },
    }]
  : [];
---
<BaseLayout
  title={`${site.name_th} ๓๓ ปาง พุทธมณฑลสาย ๒`}
  suffix={false}
  description={`${site.tagline} — ดูครบทั้ง ๓๓ ปาง พร้อมความหมาย วิธีไหว้ เวลาเปิด–ปิด และการเดินทาง`}
  schema={schema}
>
  <!-- ฮีโร่: ภาพอาคาร แล้วป้ายชาดแขวนทับขอบล่างของภาพ
       ให้ภาพกับชื่ออ่านเป็นของชิ้นเดียวกันอย่างป้ายจริงที่แขวนบนตัวอาคาร
       ไม่ใช่ภาพหนึ่งกล่อง ชื่อหนึ่งกล่อง เรียงต่อกันลงมา -->
  <section class:list={['hero zone-gilt', hasFacade && 'hero--photo']}>
    {hasFacade && (
      <div class="hero__photo">
        <ShrinePhoto
          name="shrine-exterior"
          alt={`หน้าอาคาร${site.name_th} ${site.name_zh}`}
          ratio="1086 / 772" sizes="100vw" priority
        />
      </div>
    )}
    <div class="wrap hero__inner">
      <div class="plaque-board fret hero__plaque">
        <span class="plaque-board__prefix han">{site.plaque_prefix_zh}</span>
        <h1 class="plaque-board__zh han foil foil--live">{site.name_zh}</h1>
        <span class="plaque-board__th">{site.name_th}</span>
      </div>

      {/* บรรทัดเดียวตอบสองคำถามแรกของคนที่เพิ่งมาถึง: อยู่ที่ไหน ไหว้อะไร */}
      <p class="hero__where">
        <span class="han hero__where-zh">{site.motto_zh}</span>
        <span class="hero__where-sep" aria-hidden="true">·</span>
        <span>ถนนพุทธมณฑลสาย ๒ เขตทวีวัฒนา</span>
      </p>
      <p class="hero__lede">{site.tagline}</p>

      <div class="hero__cta">
        {preOpening ? (
          <>
            <a class="btn btn--plaque hero__btn" href="/opening">
              <span>พิธีเปิด {thaiDate(openingDate, 'short')}</span>
              {daysToOpening > 0 && <span class="hero__count mono">อีก {daysToOpening} วัน</span>}
            </a>
            <a class="btn btn--ghost hero__btn" href="/33-pang">ดู ๓๓ ปาง</a>
          </>
        ) : (
          <>
            <a class="btn btn--plaque hero__btn" href="/33-pang">ดู ๓๓ ปางทั้งหมด</a>
            <a class="btn btn--ghost hero__btn" href="/worship/how-to">วิธีไหว้</a>
          </>
        )}
      </div>
    </div>
  </section>

  <HoursBar />

  <!-- ๓๓ ปางคืออะไร -->
  <section class="band">
    <div class="wrap">
      <div class="intro">
        <div class="intro__text">
          <p class="eyebrow eyebrow--marked">หัวใจของตำหนัก</p>
          <h2>๓๓ ปาง คืออะไร</h2>
          <p>
            ในสัทธรรมปุณฑรีกสูตร บทสมันตมุขปริวรรต กล่าวว่าพระโพธิสัตว์กวนอิม
            ทรงแสดงพระองค์ตามแต่ผู้ที่ร้องขอจะรับได้ — ผู้ใดควรโปรดด้วยรูปใด ก็ทรงปรากฏด้วยรูปนั้น
          </p>
          <p>
            ภายหลังคติจีนจึงประมวลออกเป็น ๓๓ ปาง แต่ละปางมีลักษณะ สิ่งที่ทรงถือ และความหมายต่างกัน
            ตำหนักแห่งนี้ตั้งชื่อตามเกาะผู่โถวซาน (普陀山) พุทธสถานของพระโพธิสัตว์กวนอิมที่ใหญ่ที่สุดในจีน
            และตั้งใจประดิษฐานให้ครบทั้ง ๓๓ ปาง
          </p>
          <p class="intro__status mono">
            ประดิษฐานแล้ว {count.enshrined} องค์
            {count.pending > 0 && <> · กำลังอัญเชิญอีก {count.pending} องค์</>}
          </p>
          <p><a class="btn btn--ghost" href="/33-pang">ดูครบทั้ง ๓๓ ปาง</a></p>
        </div>
        <aside class="intro__aside panel">
          <h3>ขอพรเรื่องไหน ไหว้ปางใด</h3>
          <p class="small">เลือกจากสิ่งที่กำลังขอ แล้วดูว่าปางใดที่คนนิยมมากราบ</p>
          <ul class="chips">
            <li><a class="chip" href="/wish/health">สุขภาพ</a></li>
            <li><a class="chip" href="/wish/children">ขอบุตร</a></li>
            <li><a class="chip" href="/wish/career">การงาน</a></li>
            <li><a class="chip" href="/wish/trade">ค้าขาย</a></li>
            <li><a class="chip" href="/wish/love">ความรัก</a></li>
            <li><a class="chip" href="/wish/travel">เดินทาง</a></li>
            <li><a class="chip" href="/wish/protection">คุ้มครอง</a></li>
            <li><a class="chip" href="/wish/peace">คลายทุกข์</a></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- ๘ องค์เด่น: ตู้จัดแสดงบนพื้นรักเข้ม ไม่ใช่กำแพงซุ้ม ๓๓ ช่อง
       ๓๓ ช่องที่หน้าตาเหมือนกันหมดทำให้หน้าแรกอ่านเป็นตารางที่ยังไม่ได้ใส่ของ -->
  <section class="band zone-gilt featured">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow eyebrow--marked">๐๑ — ๓๓</p>
          <h2>องค์เจ้าแม่กวนอิมในตำหนัก</h2>
        </div>
        <a class="btn btn--ghost" href="/33-pang">ดูครบทั้ง ๓๓ ปาง</a>
      </div>
      <p class="featured__lede">
        เลือกมาหมวดพรละหนึ่งองค์ จากทั้งหมด {count.total} องค์
      </p>

      <div class="pang-grid">
        {featured.map((p, i) => <PangCard pang={p} priority={i < 4} />)}
      </div>
    </div>
  </section>

  <VideoBand />

  <!-- วันสำคัญ + ข่าว อยู่แถบเดียวกัน — ทั้งคู่คือ "มีอะไรใหม่" เหมือนกัน
       แยกเป็นสองแถบทำให้หน้าแรกยืดและจังหวะเท่ากันไปหมด -->
  {(upcoming.length > 0 || freshNews.length > 0) && (
    <section class="band">
      <hr class="rule-fret" aria-hidden="true" />
      <div class="wrap">
        <div class="news-cols">
          {upcoming.length > 0 && (
            <div>
              <div class="section-head section-head--row">
                <div>
                  <p class="eyebrow eyebrow--marked">ปฏิทิน</p>
                  <h2>วันสำคัญถัดไป</h2>
                </div>
                <a class="link-gold" href="/calendar">ปฏิทินทั้งปี ›</a>
              </div>
              <EventList events={upcoming} compact />
            </div>
          )}

          {freshNews.length > 0 && (
            <div>
              <div class="section-head section-head--row">
                <div>
                  <p class="eyebrow eyebrow--marked">ข่าวสาร</p>
                  <h2>ประกาศจากตำหนัก</h2>
                </div>
                <a class="link-gold" href="/news">ข่าวทั้งหมด ›</a>
              </div>
              <ul class="news-list">
                {freshNews.map((n) => (
                  <li>
                    <a href={`/news/${n.id}`}>
                      <time class="mono" datetime={isoDate(n.data.date)}>{thaiDate(n.data.date, 'short')}</time>
                      <span class="news-list__title">{n.data.title}</span>
                      {n.data.summary && <span class="news-list__sum">{n.data.summary}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- แผนที่ + ที่อยู่ -->
  <section class="band zone-gilt">
    <hr class="rule-fret" aria-hidden="true" />
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow--marked">การเดินทาง</p>
        <h2>ตำหนักอยู่ที่ไหน</h2>
      </div>
      <VisitPanel />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; }

  /* ภาพกับป้ายต้องซ้อนกัน ป้ายจึงยื่นขึ้นไปทับขอบล่างของภาพ
     ค่าลบนี้คือ "ความลึกที่ป้ายแขวนอยู่บนตัวอาคาร" */
  .hero { --hang: clamp(34px, 6vw, 52px); }

  /* มือถือ: ภาพเต็มขอบจอ ไม่มีกรอบ — จอเล็กทุกพิกเซลต้องเป็นภาพ ไม่ใช่ขอบ
     อาคารในภาพสูงเกือบเต็มเฟรม จึงไม่ครอปบน–ล่าง คุมด้วยความกว้างเสมอ */
  .hero__photo {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }
  .hero__photo :global(.shrine-photo) {
    width: 100%;
    aspect-ratio: 1086 / 772 !important;
  }
  /* จอกว้าง: ภาพจำกัดความกว้างและผูกกับความสูงจอ ให้ป้ายยังอยู่ในจอแรก
     กรอบเป็นเส้นทองบาง ๆ เส้นเดียวพอ กรอบหนา ๆ อ่านเป็นรูปในร้านขายกรอบ */
  @media (min-width: 720px) {
    .hero__photo {
      width: min(100% - 64px, 880px, 56vh * 1.407);
      margin-top: clamp(20px, 3.4vw, 36px);
    }
    /* กรอบทองลาย 回紋 รอบภาพอาคาร — ใส่เฉพาะจอที่ภาพไม่ชนขอบจอ
       บนมือถือภาพเต็มความกว้าง กรอบจะกลายเป็นขอบจอ ไม่ใช่กรอบภาพ */
    .hero__photo {
      border: 14px solid transparent;
      border-image: var(--fret-light) 26 round;
      box-shadow: 0 22px 48px -22px rgba(90, 62, 20, .4);
    }
    .hero__photo :global(.shrine-photo) { box-shadow: 0 0 0 1px rgba(134, 99, 18, .3); }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 0 clamp(36px, 6vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* ไม่มีภาพ: ป้ายอยู่บนพื้นเปล่า ไม่ต้องยื่น */
  .hero:not(.hero--photo) .hero__inner { padding-top: clamp(44px, 8vw, 80px); }

  .hero__plaque {
    width: min(100% - 32px, 520px);
    margin-top: calc(-1 * var(--hang));
    /* ป้ายที่แขวนทับภาพต้องมีเงาตกลงบนภาพ ไม่งั้นดูเหมือนวางแปะ */
    box-shadow:
      0 1px 1px rgba(60, 8, 6, .3),
      0 8px 18px rgba(60, 8, 6, .26),
      0 28px 56px -18px rgba(60, 8, 6, .5),
      inset 0 1px 0 rgba(246, 227, 176, .22);
  }
  .hero--photo .hero__plaque { margin-top: calc(-1 * var(--hang)); }
  @media (min-width: 720px) {
    .hero__plaque { width: min(100% - 64px, 500px); padding-block: 22px 24px; }
    .hero__plaque :global(.plaque-board__zh) { font-size: clamp(34px, 4.6vw, 50px); }
  }

  .hero__where {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline;
    gap: 4px 12px;
    margin: 22px 0 0;
    font-family: var(--sans);
    font-size: clamp(13px, 1.7vw, 14.5px);
    font-weight: 600;
    letter-spacing: .14em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .hero__where-zh { letter-spacing: .3em; padding-left: .3em; }
  .hero__where-sep { opacity: .5; }

  /* ประโยคเดียว ตัวไม่มีเชิง ตัดบรรทัดให้สมดุล
     เซอริฟบางที่ 17px บนจอ Android จะสั่นและอ่านยาก */
  .hero__lede {
    margin: 14px 0 0;
    max-width: 30ch;
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(17px, 2.1vw, 19px);
    line-height: 1.7;
    color: var(--ink-2);
    text-wrap: balance;
  }

  /* ปุ่มสองปุ่มกว้างเท่ากันเสมอ ปุ่มกว้างไม่เท่ากันอ่านเป็นงานยังไม่เสร็จ */
  .hero__cta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: min(100%, 460px);
    margin-top: 26px;
  }
  .hero__btn { width: 100%; flex-direction: column; gap: 1px; padding-inline: 12px; line-height: 1.25; }
  .hero__count { font-size: 12.5px; font-weight: 500; opacity: .82; letter-spacing: .04em; }
  @media (max-width: 380px) { .hero__cta { grid-template-columns: 1fr; } }

  /* ---------- bands ---------- */
  .band--sunk { background: var(--surface-2); }
  .band--sunk + .band, .band + .band--sunk { border-top: 0; }
  /* โซนมืดเป็นก้อนของตัวเอง ไม่ต้องมีเส้นคั่นซ้อนอีก */
  .band.zone-gilt { border-top: 0; }
  .band.zone-gilt + .band { border-top: 0; }

  /* ๙ ส่วนเด่นสูงกว่าส่วนรอง เพื่อให้หน้ามีจังหวะ ไม่ใช่บล็อกระยะเท่ากันหมด */
  .featured { padding-block: clamp(52px, 8vw, 92px); }
  .featured__lede { margin: -8px 0 26px; color: var(--ink-3); font-size: 15.5px; }

  .news-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 44px 56px; }
  .section-head--row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* ---------- intro ---------- */
  .intro { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, 1fr); gap: 36px 48px; align-items: start; }
  .intro__text > * + * { margin-top: 16px; }
  .intro__text h2 { margin-top: 8px; }
  .intro__status { font-size: 15px; color: var(--celadon); }
  .intro__aside { padding: 22px 22px 24px; border-top: 3px solid var(--gold-bright); }
  .intro__aside h3 { font-size: 19px; }
  .intro__aside .small { margin: 8px 0 16px; color: var(--ink-2); }
  @media (max-width: 780px) { .intro { grid-template-columns: 1fr; } }

  /* ---------- grid ---------- */
  /* ๘ ใบพอดีสองแถวบนจอกว้าง และสองคอลัมน์บนมือถือ */
  .pang-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) { .pang-grid { grid-template-columns: repeat(3, 1fr); gap: 14px; } }
  @media (max-width: 560px) { .pang-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

  /* ---------- news ---------- */
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li { border-top: 1px solid var(--line); }
  .news-list li:last-child { border-bottom: 1px solid var(--line); }
  .news-list a {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 4px 20px;
    padding: 16px 0;
    text-decoration: none;
    color: inherit;
  }
  .news-list a:hover .news-list__title { color: var(--lacquer); }
  .news-list time { font-size: 15px; color: var(--ink-3); }
  .news-list__title { font-size: 17.5px; font-weight: 500; line-height: 1.5; }
  .news-list__sum { grid-column: 2; font-size: 15.5px; color: var(--ink-2); line-height: 1.6; }
  @media (max-width: 560px) {
    .news-list a { grid-template-columns: 1fr; }
    .news-list__sum { grid-column: 1; }
  }
</style>
