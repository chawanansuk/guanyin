---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ShrinePhoto from '../components/ShrinePhoto.astro';
import PangCard from '../components/PangCard.astro';
import photos from '../data/photos.json';
import photoMeta from '../data/photo-meta.json';
import { allPang } from '../lib/pang';

const images = photos.images as Record<string, { widths: number[]; w: number; h: number }>;
const hasFacade = 'shrine-exterior' in images;
const map = images['visit-map'];
// เฉพาะองค์ที่มีภาพถ่ายจริง — ภาพประกอบ AI ไม่เข้าประมวลภาพ
const real = (await allPang()).filter(
  (p) => p.data.photo in images && !(photoMeta.illustrations as string[]).includes(p.data.photo),
);
---
<BaseLayout
  title="ประมวลภาพ"
  description={`ภาพองค์เจ้าแม่กวนอิม ${real.length} ปางในตำหนักผู่โถว หน้าอาคาร และแผนที่การเดินทาง`}
  breadcrumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'ประมวลภาพ', href: '/gallery' }]}
>
  <PageHero
    eyebrow="ประมวลภาพ"
    title="ประมวลภาพ"
    lede={`องค์เจ้าแม่กวนอิม ${real.length} ปางที่ประดิษฐานในตำหนัก หน้าอาคาร และแผนที่ — กดที่องค์ใดเพื่ออ่านความหมายของปางนั้น`}
    narrow
  />
  {hasFacade && (
    <section class="band">
      <div class="wrap wrap--narrow">
        <figure class="shot">
          <ShrinePhoto
            name="shrine-exterior"
            alt="หน้าอาคารตำหนักผู่โถวเจ้าแม่กวนอิม ถนนพุทธมณฑลสาย ๒"
            ratio="1086 / 772" sizes="(max-width: 820px) 92vw, 760px" priority
          />
          <figcaption>หน้าอาคารตำหนัก ถนนพุทธมณฑลสาย ๒</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="band band--sunk">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow--marked">องค์ในตำหนัก</p>
        <h2>องค์เจ้าแม่กวนอิม {real.length} ปาง</h2>
      </div>
      <p class="lede-sm">
        พระขาวเนื้อกระเบื้องเต๋อฮั่ว ถ่ายทีละองค์ก่อนประดิษฐาน ปางที่ยังไม่มีองค์อีก {33 - real.length} ปาง
        ดูรายชื่อครบได้ที่<a href="/33-pang">หน้า ๓๓ ปาง</a>
      </p>
      <div class="pang-grid">
        {real.map((p, i) => <PangCard pang={p} priority={i < 4} />)}
      </div>
    </div>
  </section>

  {map && (
    <section class="band">
      <div class="wrap wrap--narrow">
        <figure class="shot">
          <a href="/visit">
            <img
              src={`/images/pang/visit-map-${map.widths[0]}.webp`}
              srcset={map.widths.map((w) => `/images/pang/visit-map-${w}.webp ${w}w`).join(', ')}
              sizes="(max-width: 820px) 92vw, 760px" width={map.w} height={map.h}
              alt="แผนที่การเดินทางไปตำหนัก ถนนพุทธมณฑลสาย ๒ ระหว่างซอย ๑๑ กับซอย ๑๒" loading="lazy" decoding="async"
            />
          </a>
          <figcaption>แผนที่การเดินทาง — รายละเอียดที่<a href="/visit">หน้าการเดินทาง</a></figcaption>
        </figure>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .shot { margin: 0; }
  .shot :global(.shrine-photo), .shot img {
    display: block; width: 100%; height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--gold-line), var(--shadow-lift);
  }
  .shot figcaption { margin-top: 12px; font-size: 14.5px; color: var(--ink-3); }
  .lede-sm { margin: -8px 0 24px; color: var(--ink-2); max-width: var(--measure); }
  .pang-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(178px, 1fr)); gap: 1px; }
  @media (max-width: 420px) { .pang-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
