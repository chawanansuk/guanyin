---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ShrinePhoto from '../components/ShrinePhoto.astro';
import photos from '../data/photos.json';

const hasFacade = 'shrine-exterior' in (photos.images as Record<string, unknown>);
---
<BaseLayout
  title="ประมวลภาพ"
  description="ภาพตำหนักผู่โถวเจ้าแม่กวนอิม องค์ ๓๓ ปาง และบรรยากาศงานพิธี"
  breadcrumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'ประมวลภาพ', href: '/gallery' }]}
>
  <PageHero
    eyebrow="ประมวลภาพ"
    title="ประมวลภาพ"
    lede="ภาพองค์ ๓๓ ปาง บรรยากาศตำหนัก และภาพงานพิธี"
    narrow
  />
  {hasFacade && (
    <section class="band">
      <div class="wrap wrap--narrow">
        <figure class="shot">
          <ShrinePhoto
            name="shrine-exterior"
            alt="หน้าอาคารตำหนักผู่โถวเจ้าแม่กวนอิม ถนนพุทธมณฑลสาย ๒"
            ratio="1086 / 772" sizes="(max-width: 820px) 92vw, 760px" priority
          />
          <figcaption>หน้าอาคารตำหนัก ถนนพุทธมณฑลสาย ๒</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap wrap--narrow">
      <div class="note">
        <p>
          <strong>คลังภาพกำลังจัดทำ</strong>{' '}
          ชุดภาพองค์ ๓๓ ปางถ่ายพร้อมกันในคราวเดียวเพื่อให้แสงและมุมกล้องเหมือนกันทุกองค์
          เมื่อถ่ายเสร็จจะขึ้นที่นี่และที่หน้าปางแต่ละหน้า
        </p>
        <p>ระหว่างนี้ดูรายชื่อและความหมายของทุกปางได้ที่<a href="/33-pang">หน้า ๓๓ ปาง</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .shot { margin: 0; }
  .shot :global(.shrine-photo) {
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--gold-line), var(--shadow-lift);
  }
  .shot figcaption {
    margin-top: 12px;
    font-size: 14.5px;
    color: var(--ink-3);
  }
</style>
