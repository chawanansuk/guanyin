---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<BaseLayout
  title="เครื่องบูชาและข้อห้าม"
  description="ของที่นิยมนำมาถวายเจ้าแม่กวนอิม ผลไม้ ดอกไม้ และสิ่งที่ไม่ควรนำมา ที่ตำหนักผู่โถว พุทธมณฑลสาย ๒ — ตำหนักนี้ไม่จุดธูปเทียน"
  breadcrumbs={[
    { label: 'หน้าแรก', href: '/' },
    { label: 'การบูชา', href: '/worship' },
    { label: 'เครื่องบูชา', href: '/worship/offerings' },
  ]}
>
  <PageHero
    eyebrow="การบูชา"
    title="เครื่องบูชาและข้อห้าม"
    lede="เจ้าแม่กวนอิมทรงถือมังสวิรัติ เครื่องบูชาจึงเป็นของไม่มีเนื้อสัตว์ทั้งหมด — ข้อนี้เป็นข้อที่ผู้มาครั้งแรกมักไม่ทราบ"
    narrow
  />

  <section class="band">
    <div class="wrap wrap--narrow">
      <div class="note nosmoke">
        <p>
          <strong>ตำหนักนี้ไม่จุดธูปและไม่จุดเทียน</strong>
          ไม่ต้องซื้อและไม่ต้องนำมา — กราบด้วยการพนมมือถือว่าครบถ้วนแล้ว
          เครื่องบูชาด้านล่างเป็นของที่ถวายได้โดยไม่ต้องจุดไฟ
        </p>
      </div>

      <h2>ของที่นิยมถวาย</h2>
      <div class="tablebox tablebox--wrap">
        <table>
          <thead><tr><th>สิ่งของ</th><th>ความหมาย</th></tr></thead>
          <tbody>
            <tr><td>ดอกบัว หรือดอกไม้สีขาว·เหลือง</td><td>ความบริสุทธิ์ ดอกบัวเป็นดอกไม้ประจำพระโพธิสัตว์</td></tr>
            <tr><td>ผลไม้มงคล ๕ อย่าง</td><td>ส้ม สาลี่ แอปเปิล กล้วย องุ่น — เลี่ยงผลไม้ที่มีชื่อไม่เป็นมงคล</td></tr>
            <tr><td>น้ำสะอาด หรือน้ำชา</td><td>ความใสสะอาดของจิตใจ</td></tr>
            <tr><td>ขนมมังสวิรัติ</td><td>ขนมเปี๊ยะ ซาลาเปาไส้ถั่ว ขนมอี๋</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="mt">สิ่งที่ไม่ควรนำมาถวาย</h2>
      <ul class="dont">
        <li><strong>เนื้อสัตว์ทุกชนิด</strong> รวมถึงไก่ หมู เป็ด ไข่ และอาหารที่ปรุงด้วยน้ำมันหมู</li>
        <li><strong>เหล้าและของมึนเมา</strong></li>
        <li><strong>ผักฉุนห้าชนิด</strong> — กระเทียม หัวหอม หลักเกียว กุยช่าย ใบยาสูบ (ตามคติมังสวิรัติจีน)</li>
        <li><strong>ธูป เทียน และกระดาษเงินกระดาษทอง</strong> ตำหนักไม่จุดไฟทุกชนิด</li>
        <li>ดอกไม้ที่มีหนามหรือกลิ่นแรงเกินไป</li>
      </ul>

      <div class="note">
        <p>
          <strong>ของที่ถวายแล้วรับกลับได้</strong> ผลไม้และขนมที่ถวายเสร็จพิธี
          สามารถรับกลับไปรับประทานในครอบครัวเป็นสิริมงคล ไม่ถือว่าผิดธรรมเนียม
        </p>
        <p>
          การมากราบไหว้โดยไม่มีเครื่องบูชาก็ทำได้ ไม่ถือว่าขาดความเคารพ
          สิ่งที่ตำหนักถือเป็นสำคัญคือความตั้งใจของผู้มา ไม่ใช่มูลค่าของที่นำมา
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h2 { font-size: 21px; margin-bottom: 14px; }
  .mt { margin-top: 44px; }
  .dont { margin: 0; padding-left: 1.2em; }
  .dont li { margin-bottom: 9px; color: var(--ink-2); }
  .dont strong { color: var(--ink); }
  .note { margin-top: 34px; }
  .nosmoke { margin-top: 0; margin-bottom: 30px; }
  .nosmoke strong { color: var(--lacquer); }
</style>
