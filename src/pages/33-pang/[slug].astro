---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PangArt from '../../components/PangArt.astro';
import ShrinePhoto from '../../components/ShrinePhoto.astro';
import photoMeta from '../../data/photo-meta.json';
import ShareBar from '../../components/ShareBar.astro';
import site from '../../lib/site';
import { getCollection, render } from 'astro:content';
import { allPang, displayName, altNames, isVerified, prevPang, nextPang } from '../../lib/pang';
import { pangNo, thaiNum } from '../../lib/format';
import photos from '../../data/photos.json';

export async function getStaticPaths() {
  const list = (await getCollection('pang')).sort((a, b) => a.data.order - b.data.order);
  const wishes = await getCollection('wishes');
  const full = await getCollection('pangFull');
  return list.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, index: i, list, wishes, chapter: full.find((f) => f.data.slug === entry.data.slug) },
  }));
}

const { entry, index, list, wishes, chapter } = Astro.props;
const d = entry.data;
const name = displayName(entry);
const verified = isVerified(entry);
// บทเต็มเคยอยู่แยกที่ /full — ยุบมาไว้หน้านี้หน้าเดียว (หน้าเดิม redirect มาที่นี่ใน vercel.json)
// ไม่มีบทเต็มเมื่อไรค่อยใช้ย่อหน้าสั้นใต้ frontmatter ของปาง
const { Content } = await render(chapter ?? entry);

// ---------- องค์จริงในตำหนัก ----------
// ส่วนที่ตำหนักเป็นเจ้าของ แสดงเมื่อมีข้อมูลเท่านั้น และติดป้ายรอยืนยันจนกว่าผู้รู้จะตรวจ
const shrineConfirmed = d.verified_by.trim() !== '';
const paras = (s: string) => s.split(/\n{2,}/).map((x) => x.trim()).filter(Boolean);
const hasPhoto = (n: string) => !!n && n in (photos.images as Record<string, unknown>);
const facts = [
  ['ท่า', d.posture],
  ['สิ่งที่ทรงถือ', d.holds],
  ['ฐานหรือสัตว์ที่รองรับ', d.base],
  ['วัสดุ', d.material],
  ['ความสูง', d.height_cm ? `${d.height_cm} ซม.` : ''],
  ['ที่มา', d.maker],
  ['ผู้ถวาย', d.donor],
].filter(([, v]) => v) as [string, string][];
const shrinePhotos = [d.photo_detail, d.photo_place].filter(hasPhoto);
const hasShrine = facts.length > 0 || !!d.shrine_statue || !!d.shrine_highlight || shrinePhotos.length > 0;
const prayerPage = d.prayer ? (await getCollection('prayers')).find((p) => p.id === d.prayer) : undefined;

// ---------- ปางที่เกี่ยวข้อง ----------
const bySlug = (slug: string) => list.find((p: any) => p.data.slug === slug);
const confused = d.confused_with
  .map((c) => ({ p: bySlug(c.slug), note: c.note }))
  .filter((c) => c.p);
const seeAlso = d.see_also.map(bySlug).filter(Boolean);
const prev = prevPang(list, index);
const next = nextPang(list, index);
const alts = altNames(entry);
const myWishes = wishes
  .filter((w: any) => d.wishes.includes(w.data.id))
  .sort((a: any, b: any) => a.data.order - b.data.order);

const path = `/33-pang/${d.slug}`;
const description =
  `${name} (${d.name_zh}) ปางที่ ${d.order} ใน ๓๓ ปางของเจ้าแม่กวนอิม — ` +
  `${d.attributes} นิยมขอพรเรื่อง${myWishes.map((w: any) => w.data.short).join(' ')} ` +
  `ที่ตำหนักผู่โถว พุทธมณฑลสาย ๒`;
---
<BaseLayout
  title={`${name} ${d.name_zh}`}
  description={description}
  noindex={!verified}
  schema={d.faq.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }] : []}
  ogImage={`/og/pang-${String(d.order).padStart(2, '0')}.jpg`}
  breadcrumbs={[
    { label: 'หน้าแรก', href: '/' },
    { label: '๓๓ ปาง', href: '/33-pang' },
    { label: name, href: path },
  ]}
>
  <!-- บล็อกสำหรับคนที่สแกน QR จากในตำหนัก: ตอบคำถามที่ถามตอนยืนอยู่หน้าองค์ -->
  <aside class="qr zone-gilt">
    <div class="wrap qr__inner">
      <p class="qr__head">ยืนอยู่หน้าองค์นี้ใช่ไหม</p>
      <p class="qr__where">
        {d.shrine_point !== null
          ? <span>จุดที่ <strong>{thaiNum(d.shrine_point)}</strong> ในตำหนัก</span>
          : <span>องค์นี้อยู่ในหมู่ ๓๓ ปางของตำหนัก</span>}
        <span class="qr__nosmoke"> · ตำหนักนี้<strong>ไม่จุดธูปเทียน</strong> กราบด้วยการพนมมือ</span>
      </p>
      <p class="qr__pray">“{d.short_prayer}”</p>
    </div>
  </aside>

  <article class="pang">
    <div class="wrap pang__grid">
      <div class="pang__art zone-hall">
        <PangArt
          photo={d.photo} order={d.order} nameTh={name} nameZh={d.name_zh}
          enshrined={d.enshrined} priority sizes="(max-width: 820px) 92vw, 420px"
        />
        {(photoMeta.illustrations as string[]).includes(d.photo) && (
          <p class="pang__artnote">
            ภาพประกอบ ไม่ใช่ภาพถ่ายองค์จริงที่ประดิษฐานในตำหนัก
            ใช้แสดงลักษณะของปางไว้ก่อนระหว่างรอภาพถ่ายจริง
          </p>
        )}
        {!d.enshrined && (
          <p class="pang__pending">องค์นี้ยังอยู่ระหว่างการอัญเชิญมาประดิษฐาน</p>
        )}
      </div>

      <div class="pang__main">
        <p class="pang__no mono">{pangNo(d.order)} / ๓๓</p>
        <h1>{name}</h1>
        <p class="pang__names">
          <span class="han pang__zh">{d.name_zh}</span>
          <span class="pang__py">{d.name_pinyin}</span>
          {d.name_thai_reading && <span class="pang__read">{d.name_thai_reading}</span>}
          {d.name_japanese && <span class="pang__read">ญี่ปุ่น: {d.name_japanese}</span>}
        </p>

        {d.essence && (
          <p class="pang__essence">
            <span class="pang__essence-label">แก่นของปาง</span>
            {d.essence}
          </p>
        )}

        <ul class="chips pang__wishes">
          {myWishes.map((w: any) => (
            <li><a class="chip" href={`/wish/${w.data.id}`}>{w.data.short}</a></li>
          ))}
        </ul>

        <section class="pang__sec">
          <h2>ลักษณะเด่น</h2>
          <p>{d.attributes}</p>
        </section>

        {d.keypoints.length > 0 && (
          <section class="pang__sec">
            <h2>สรุปสั้น ๆ</h2>
            <ul class="keypoints">
              {d.keypoints.map((k: string) => <li>{k}</li>)}
            </ul>
          </section>
        )}

        {hasShrine && (
          <section class="pang__sec">
            <h2>
              องค์ที่ตำหนักผู่โถว
              {!shrineConfirmed && <span class="pang__tag">รอตำหนักยืนยัน</span>}
            </h2>
            {paras(d.shrine_statue).map((t) => <p>{t}</p>)}
            {facts.length > 0 && (
              <dl class="pang__facts">
                {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
              </dl>
            )}
            {d.shrine_highlight && (
              <p class="pang__look"><strong>สังเกตที่องค์นี้</strong> {d.shrine_highlight}</p>
            )}
            {shrinePhotos.length > 0 && (
              <div class="pang__photos">
                {hasPhoto(d.photo_detail) && (
                  <ShrinePhoto name={d.photo_detail} ratio="1 / 1" sizes="(max-width: 899px) 46vw, 260px"
                    alt={`รายละเอียดองค์${name} ${d.name_zh} ในตำหนักผู่โถว`} />
                )}
                {hasPhoto(d.photo_place) && (
                  <ShrinePhoto name={d.photo_place} ratio="4 / 3" sizes="(max-width: 899px) 92vw, 520px"
                    alt={`องค์${name} ในที่ตั้งจริงภายในตำหนักผู่โถว`} />
                )}
              </div>
            )}
          </section>
        )}

        {d.how_to_ask && (
          <section class="pang__sec">
            <h2>
              ขอพรปางนี้อย่างไร
              {!shrineConfirmed && <span class="pang__tag">รอตำหนักยืนยัน</span>}
            </h2>
            {paras(d.how_to_ask).map((t) => <p>{t}</p>)}
            <blockquote class="pang__prayer">“{d.short_prayer}”</blockquote>
            {prayerPage && (
              <p>บทสวดที่ใช้กับปางนี้ <a href={`/worship/prayers/${prayerPage.id}`}>{prayerPage.data.title}</a></p>
            )}
          </section>
        )}

        <section class="pang__sec">
          <h2>ความหมายและเรื่องเล่า</h2>
          {verified ? (
            <>
              {chapter && (
                <p class="pang__evidence">
                  ส่วนนี้บอกไว้เสมอว่าเรื่องใดมาจากพระสูตรหรือเอกสารเก่า เรื่องใดเป็นตำนานที่เล่าสืบกันมา
                  และส่วนใดเป็นข้อคิดสำหรับชีวิตวันนี้
                </p>
              )}
              <div class="prose pang__story"><Content /></div>
            </>
          ) : (
            <div class="note note--lacquer">
              <p>
                <strong>เนื้อหาส่วนนี้ยังรอผู้รู้ของตำหนักตรวจสอบ</strong>{' '}
                จึงยังไม่เผยแพร่ เพื่อไม่ให้เว็บกลายเป็นแหล่งอ้างอิงของข้อมูลที่ยังไม่ได้ตรวจ
              </p>
              <p>
                ระหว่างนี้ ชื่อ ภาพ ลักษณะเด่น และพรที่นิยมขอด้านบน
                เพียงพอสำหรับการกราบไหว้แล้ว
              </p>
            </div>
          )}
        </section>

        {confused.length > 0 && (
          <section class="pang__sec">
            <h2>ปางที่มักสับสนกัน</h2>
            <ul class="pang__rel">
              {confused.map(({ p, note }) => (
                <li>
                  <a href={`/33-pang/${p!.data.slug}`}>
                    <span class="mono pang__rel-no">{pangNo(p!.data.order)}</span>
                    <span class="pang__rel-name">{displayName(p!)}</span>
                    <span class="han pang__rel-zh">{p!.data.name_zh}</span>
                  </a>
                  <p>{note}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {seeAlso.length > 0 && (
          <section class="pang__sec">
            <h2>กราบปางนี้แล้ว ไปต่อที่ปางใด</h2>
            <ul class="pang__rel">
              {seeAlso.map((p: any) => (
                <li>
                  <a href={`/33-pang/${p.data.slug}`}>
                    <span class="mono pang__rel-no">{pangNo(p.data.order)}</span>
                    <span class="pang__rel-name">{displayName(p)}</span>
                    <span class="han pang__rel-zh">{p.data.name_zh}</span>
                    {p.data.shrine_point !== null && <span class="pang__rel-pt">จุดที่ {thaiNum(p.data.shrine_point)}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {d.faq.length > 0 && (
          <section class="pang__sec">
            <h2>ถามสั้น ตอบสั้น</h2>
            <dl class="pang__faq">
              {d.faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
            </dl>
          </section>
        )}

        {d.shrine_point !== null && (
          <section class="pang__sec">
            <h2>ตำแหน่งในตำหนัก</h2>
            <p>จุดที่ {thaiNum(d.shrine_point)} ตามลำดับการเดินไหว้ — ดู <a href="/about/sacred-objects">ผังจุดไหว้ในตำหนัก</a></p>
          </section>
        )}

        {(alts.length > 0 || d.sources.length > 0 || d.source_doc) && (
          <section class="pang__sec pang__meta">
            {alts.length > 0 && (
              <p class="small"><span class="pang__metalabel">ชื่ออื่นที่พบ</span> {alts.join(' · ')}</p>
            )}
            {d.sources.length > 0 && (
              <p class="small"><span class="pang__metalabel">อ้างอิง</span> {d.sources.join(' · ')}</p>
            )}
            {d.source_doc && (
              <p class="small"><span class="pang__metalabel">เรียบเรียงจาก</span> {d.source_doc}</p>
            )}
            {d.verified_by && (
              <p class="small"><span class="pang__metalabel">ผู้รู้ของตำหนักตรวจแล้ว</span> {d.verified_by}</p>
            )}
          </section>
        )}

        <div class="pang__share">
          <ShareBar title={`${name} ${d.name_zh}`} path={path} />
        </div>
      </div>
    </div>

    <nav class="pang__nav zone-gilt" aria-label="ปางก่อนหน้าและถัดไป">
      <div class="wrap pang__nav-inner">
        <a class="pang__nav-link pang__nav-link--prev" href={`/33-pang/${prev.data.slug}`}>
          <span class="pang__nav-dir">‹ ปางก่อนหน้า</span>
          <span class="pang__nav-name">{pangNo(prev.data.order)} {displayName(prev)}</span>
        </a>
        <a class="pang__nav-all" href="/33-pang">ดูทั้ง ๓๓ ปาง</a>
        <a class="pang__nav-link pang__nav-link--next" href={`/33-pang/${next.data.slug}`}>
          <span class="pang__nav-dir">ปางถัดไป ›</span>
          <span class="pang__nav-name">{pangNo(next.data.order)} {displayName(next)}</span>
        </a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ---------- แถบ QR ---------- */
  /* แถบสำหรับคนที่สแกน QR ยืนอยู่หน้าองค์ — รักเข้มตัวทอง
     ของเดิมเป็นเขียวมิ้นต์ซึ่งหลุดจากระบบสองสีของเว็บ */
  /* แถบ "ยืนอยู่หน้าองค์นี้ใช่ไหม" — คนสแกน QR หน้าองค์จะเห็นแถบนี้ก่อน
     ขลิบทองบนล่างให้อ่านเป็นป้ายติดผนัง ไม่ใช่กล่องแจ้งเตือน */
  .qr { border-top: 1px solid var(--gold-bright); border-bottom: 1px solid var(--gold-bright); }
  .qr__inner { padding-block: 16px; display: flex; flex-direction: column; gap: 3px; }
  .qr__head {
    font: 600 var(--fs-caption)/1.4 var(--mono);
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--gold); margin: 0;
  }
  .qr__where { margin: 4px 0 0; font-size: var(--fs-md); color: var(--ink); }
  .qr__where strong { font-weight: 600; }
  .qr__nosmoke { color: var(--ink-2); }
  .qr__pray { margin: 5px 0 0; font-family: var(--display); font-weight: 300; font-size: var(--fs-md); color: var(--ink-2); line-height: 1.7; }

  /* ---------- เนื้อหา ---------- */
  .pang__grid {
    display: grid;
    grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
    gap: 36px 48px;
    align-items: start;
    padding-block: clamp(28px, 5vw, 48px);
  }
  @media (max-width: 899px) { .pang__grid { grid-template-columns: 1fr; gap: 26px; padding-top: 0; } }

  .pang__art { position: sticky; top: 68px; }
  /* ภาพองค์บนหน้าปางคือภาพเดียวที่คนจ้องดูนาน จึงใส่กรอบทองลาย 回紋
     ในหน้ารวมไม่ใส่ เพราะการ์ด ๓๓ ใบที่มีกรอบทุกใบจะกลายเป็นลายพร่า */
  .pang__art :global(.pang-figure) {
    border: clamp(11px, 2.6vw, 15px) solid transparent;
    border-image: var(--fret-light) 26 round;
    box-shadow: var(--shadow-lift);
  }
  .pang__art :global(.pang-art) { box-shadow: 0 0 0 1px rgba(134, 99, 18, .3); }
  @media (max-width: 899px) { .pang__art { position: relative; top: auto; } }

  /* องค์พระตั้งอยู่ในหอ — พื้นเข้มชุดเดียวกับแถบ ๘ ปางหน้าแรก
     มีแค่ภาพกับป้ายสั้นอยู่บนพื้นมืด เนื้อหาให้อ่านยังอยู่บนพื้นครีมทั้งหมด */
  .pang__art.zone-hall { padding: var(--space-6); border: 1px solid var(--gold-line); overflow: hidden; }
  @media (max-width: 899px) {
    .pang__art.zone-hall {
      margin-inline: calc(-1 * var(--gutter));
      padding: var(--space-8) var(--gutter);
      border-inline: 0;
    }
  }
  /* หน้าปางคือหน้าที่คนดูภาพนานที่สุด ป้ายเล็กมุมภาพอย่างเดียวไม่พอ
     ต้องบอกเป็นประโยคเต็มใต้ภาพด้วยว่าไม่ใช่องค์จริง */
  .pang__artnote {
    margin: 10px 0 0; padding: 9px 12px;
    background: var(--surface-2); border-left: 3px solid var(--gold-line);
    font-size: var(--fs-sm); line-height: 1.65; color: var(--ink-3);
  }
  .pang__pending {
    margin: 10px 0 0; padding: 9px 12px;
    background: var(--surface-2); border-left: 3px solid var(--line-strong);
    font-size: var(--fs-sm); color: var(--ink-2);
  }

  .pang__no { font-size: var(--fs-label); color: var(--gold); letter-spacing: .12em; margin: 0 0 8px; }
  .pang__names { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin: 10px 0 0; }
  .pang__zh { font-size: var(--fs-h3); font-weight: 700; color: var(--lacquer); }
  .pang__py { font-size: var(--fs-md); color: var(--ink-3); font-style: italic; }
  .pang__read { font-size: var(--fs-sm); color: var(--ink-3); }

  /* คีย์พอยท์: จุดนำเป็นดอกทอง ไม่ใช่จุดกลมของเบราว์เซอร์ */
  .keypoints { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .keypoints li { position: relative; padding-left: 26px; line-height: 1.7; }
  .keypoints li::before {
    content: "";
    position: absolute;
    left: 2px; top: .62em;
    width: 9px; height: 9px;
    transform: rotate(45deg);
    background: var(--gold-bright);
    box-shadow: 0 0 0 1px rgba(134, 99, 18, .35);
  }
  .pang__wishes { margin-top: 18px; }

  /* แก่นของปาง — เป็นคำอธิบายเชิงตีความ ไม่ใช่ถ้อยคำจากพระสูตร
     จึงใช้ป้ายกำกับให้ผู้อ่านรู้ว่ากำลังอ่านข้อมูลระดับใดอยู่ */
  .pang__essence {
    margin: 20px 0 0;
    padding: 14px 16px;
    background: var(--gold-soft);
    border-left: 3px solid var(--gold);
    font-family: var(--serif);
    font-size: var(--fs-md);
    line-height: 1.7;
  }
  .pang__essence-label {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-caption);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 4px;
  }

  /* ป้ายบอกว่าส่วนนี้ตำหนักยังไม่ได้ยืนยัน — เล็กพอไม่แย่งหัวข้อ แต่ต้องเห็น */
  .pang__tag {
