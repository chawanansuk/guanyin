---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PangCard from '../../components/PangCard.astro';
import confusable from '../../data/pang-confusable.json';
import { allPang, enshrinedCount } from '../../lib/pang';
import { getCollection } from 'astro:content';
import site from '../../lib/site';

const pang = await allPang();
const count = enshrinedCount(pang);
const wishes = (await getCollection('wishes')).sort((a, b) => a.data.order - b.data.order);

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'เจ้าแม่กวนอิม ๓๓ ปาง',
  numberOfItems: pang.length,
  itemListElement: pang.map((p) => ({
    '@type': 'ListItem',
    position: p.data.order,
    name: p.data.name_th_shrine || p.data.name_th,
    url: `${site.url}/33-pang/${p.data.slug}`,
  })),
}];
---
<BaseLayout
  title="เจ้าแม่กวนอิม ๓๓ ปาง — ครบทุกปาง พร้อมความหมาย"
  suffix={false}
  description="รวมเจ้าแม่กวนอิมครบทั้ง ๓๓ ปาง ชื่อไทย ชื่อจีน ลักษณะเด่น และพรที่นิยมขอ จากองค์จริงที่ประดิษฐานในตำหนักผู่โถว พุทธมณฑลสาย ๒"
  schema={schema}
  breadcrumbs={[{ label: 'หน้าแรก', href: '/' }, { label: '๓๓ ปาง', href: '/33-pang' }]}
>
  <PageHero
    eyebrow="๐๑ — ๓๓"
    title="เจ้าแม่กวนอิม ๓๓ ปาง"
    lede="๓๓ ปาง ไม่ใช่เทพเจ้า ๓๓ องค์ แต่คือพระโพธิสัตว์องค์เดียวกันที่ผู้ศรัทธาถ่ายทอดออกมาเป็น ๓๓ ภาพ แต่ละภาพเปรียบเหมือนหน้าต่างบานหนึ่ง ที่เปิดให้เห็นความกรุณาในมุมที่ต่างกันไป"
  >
    <p class="hero-status mono">
      ประดิษฐานแล้ว {count.enshrined} องค์ จาก {count.total}
      {count.pending > 0 && <> · กำลังอัญเชิญอีก {count.pending} องค์</>}
    </p>
  </PageHero>

  <section class="band">
    <div class="wrap wrap--narrow">
      <div class="prose">
        <p>
          ในพระสัทธรรมปุณฑรีกสูตร บทที่ ๒๕ ที่คนจีนเรียกว่า <strong>“ผู่เหมินผิ่น” (普門品)</strong>{' '}
          หรือ “บทประตูแห่งความกรุณาอันเปิดกว้าง” พระพุทธเจ้าตรัสว่า พระอวโลกิเตศวรทรงปรากฏ
          ในรูปกายที่เหมาะกับผู้ที่พระองค์จะช่วยเหลือ จะเป็นพระพุทธเจ้า เทวดา กษัตริย์ พ่อค้า
          นักบวช สตรี เด็ก หรือแม้แต่สิ่งมีชีวิตที่ไม่ใช่มนุษย์ก็ได้
        </p>
        <p>
          หัวใจของคำสอนนี้คือ{' '}
          <strong>ความกรุณาไม่ได้บังคับให้ทุกคนต้องเข้ามาหาในรูปแบบเดียว แต่ยอมเปลี่ยนรูปเพื่อเดินเข้าไปหาทุกคน</strong>
        </p>
        <p>
          ส่วน<strong>รายชื่อทั้ง ๓๓ ปาง</strong>เป็นชุดภาพศิลปะที่เกิดขึ้นภายหลังในจีนและญี่ปุ่น
          พระสูตรไม่ได้ระบุชื่อทั้ง ๓๓ ปางไว้ตรง ๆ ผู้รวบรวมชุดภาพยืมเลข ๓๓ และแนวคิดเรื่องการแสดงพระกาย
          มาเรียงร้อยภาพกวนอิมที่มีที่มาหลากหลายเข้าไว้ด้วยกัน จึงไม่แปลกที่ตำราแต่ละสำนัก
          จะจับคู่ปางกับรูปกายต่างกันบ้าง
        </p>
      </div>
      <div class="note note--lacquer">
        <p>
          <strong>อย่าสับสน</strong> เส้นทางไหว้พระ ๓๓ วัดในญี่ปุ่น (เช่น ไซโกกุ) เป็นอีกระบบหนึ่ง
          วัดทั้ง ๓๓ แห่งไม่ได้ประดิษฐานกวนอิม ๓๓ ปางเรียงตามรายชื่อนี้
        </p>
      </div>
    </div>
  </section>

  <section class="band zone-gilt">
    <div class="wrap">
      <!-- ตัวกรอง: ไม่มี JS ก็ยังเป็นลิงก์ไปหน้าหมวดพรได้ตามปกติ -->
      <div class="filter" data-filter>
        <p class="filter__label eyebrow">ขอพรเรื่อง</p>
        <ul class="chips">
          <li><a class="chip chip--filter chip--on" href="/33-pang" data-wish="all" aria-current="true">ทั้งหมด</a></li>
          {wishes.map((w) => (
            <li><a class="chip chip--filter" href={`/wish/${w.data.id}`} data-wish={w.data.id}>{w.data.short}</a></li>
          ))}
        </ul>
        <p class="filter__count small muted" data-count hidden></p>
      </div>

      <div class="pang-grid" data-grid>
        {pang.map((p, i) => <PangCard pang={p} priority={i < 6} />)}
      </div>

      <p class="filter__empty" data-empty hidden>ยังไม่มีปางในหมวดนี้</p>

      <div class="after note">
        <p>
          <strong>ทุกปางมีบทความฉบับเต็ม</strong> เล่าที่มาจากพระสูตรและตำนาน
          พร้อมข้อคิดสำหรับชีวิตวันนี้ และสรุปสั้น ๆ ท้ายบทสำหรับคนที่ไม่มีเวลาอ่านยาว
          กดเข้าไปในปางใดก็ได้แล้วเลือก “อ่านฉบับเต็ม”
        </p>
        <p>
          <strong>อยากรู้ว่าควรไหว้ปางไหน</strong> — หน้า{' '}
          <a href="/worship/by-wish">ขอพรเรื่องไหน ไหว้ปางใด</a>{' '}
          แยกตามสิ่งที่กำลังขอ พร้อมเหตุผลว่าทำไมปางนั้นจึงเกี่ยวข้อง
        </p>
        <p>
          ชื่อไทยของแต่ละปางในไทยมีสองสาย — สายแปลความอย่าง “ปางกิ่งหลิว” ที่ใช้ตามป้ายศาลเจ้า
          และสายแปลศัพท์ธรรมอย่าง “นีลกัณฐอวโลกิเตศวร” ที่เชื่อกลับไปหาคัมภีร์ได้
          เว็บนี้ยึด<strong>ชื่อจีนเป็นหลัก</strong> แสดงชื่อสายแปลความเป็นชื่อหน้า
          และเก็บชื่ออีกสายไว้ท้ายหน้าปาง เพื่อให้ค้นด้วยชื่อสายไหนก็เจอ
        </p>
      </div>
    </div>
  </section>

  {/* ปางที่คนมักจำสลับกัน — คำถามที่เจอหน้างานจริงบ่อยที่สุดคือ
      "องค์นี้กับองค์นั้นต่างกันตรงไหน" ตารางนี้ตอบได้ในบรรทัดเดียว */}
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow--marked">แยกให้ออก</p>
        <h2>ปางที่มักจำสลับกัน</h2>
        <p class="lede">{confusable.note}</p>
      </div>

      <div class="tablebox">
        <table>
          <thead>
            <tr><th scope="col">กลุ่มปาง</th><th scope="col">จุดที่เหมือนกัน</th><th scope="col">วิธีแยก</th></tr>
          </thead>
          <tbody>
            {confusable.rows.map((r) => (
              <tr>
                <th scope="row">{r.pair}</th>
                <td>{r.same}</td>
                <td>{r.tell}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="note note--celadon confuse__rule">
        <p><strong>หลักสำคัญ</strong> <span set:html={confusable.rule} /></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-filter]');
    var grid = document.querySelector('[data-grid]');
    if (!box || !grid) return;
    var chips = box.querySelectorAll('[data-wish]');
    var countEl = box.querySelector('[data-count]');
    var emptyEl = document.querySelector('[data-empty]');
    var cards = grid.querySelectorAll('[data-wishes]');

    function apply(wish, push) {
      var shown = 0;
      for (var i = 0; i < cards.length; i++) {
        var on = wish === 'all' || (' ' + cards[i].dataset.wishes + ' ').indexOf(' ' + wish + ' ') > -1;
        cards[i].hidden = !on;
        if (on) shown++;
      }
      for (var j = 0; j < chips.length; j++) {
        var is = chips[j].dataset.wish === wish;
        chips[j].classList.toggle('chip--on', is);
        if (is) chips[j].setAttribute('aria-current', 'true');
        else chips[j].removeAttribute('aria-current');
      }
      if (countEl) {
        countEl.hidden = wish === 'all';
        countEl.textContent = 'แสดง ' + shown + ' ปาง จาก ' + cards.length;
      }
      if (emptyEl) emptyEl.hidden = shown > 0;
      if (push) history.replaceState(null, '', wish === 'all' ? '/33-pang' : '/33-pang#' + wish);
    }

    box.addEventListener('click', function (e) {
      var a = e.target.closest('[data-wish]');
      if (!a) return;
      e.preventDefault();
      apply(a.dataset.wish, true);
    });

    var hash = location.hash.replace('#', '');
    if (hash) apply(hash, false);
  })();
</script>

<style>
  .confuse__rule { margin-top: 20px; }
  .hero-status { margin-top: 16px; font-size: 15.5px; color: var(--celadon); }

  .filter { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .filter__label { margin: 0; }
  .filter__count { margin: 0; }
  .filter__empty { margin: 28px 0 0; color: var(--ink-3); }

  .pang-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(178px, 1fr));
    gap: 16px;
  }
  @media (max-width: 560px) { .pang-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

  .after { margin-top: 32px; }
</style>
