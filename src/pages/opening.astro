---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursBar from '../components/HoursBar.astro';
import ShareBar from '../components/ShareBar.astro';
import site from '../lib/site';
import { thaiDate, daysFromToday, dayNameFull, dayOfWeek, parseDay } from '../lib/format';
import { getCollection } from 'astro:content';

const o = site.opening_ceremony;
const date = parseDay(o.date);
const left = daysFromToday(date);
const past = left < 0;

// หลังวันงาน หน้านี้กลายเป็นหน้าประมวลภาพ — URL เดิม ลิงก์ที่แชร์ไปแล้วจึงไม่ตาย
const gallery = (await getCollection('news'))
  .filter((n) => n.id.includes('opening'))
  .sort((a, b) => +b.data.date - +a.data.date);

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: o.headline,
  startDate: o.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@id': `${site.url}/#shrine` },
  image: new URL('/og/default.jpg', site.url).href,
  organizer: { '@type': 'Organization', name: site.name_th, url: site.url },
  isAccessibleForFree: true,
}];
---
<BaseLayout
  title={past ? 'ประมวลภาพพิธีเปิดตำหนัก' : `พิธีเปิดตำหนัก ${thaiDate(date, 'short')}`}
  suffix={!past}
  description={`${o.headline} วัน${dayNameFull(dayOfWeek(date))}ที่ ${thaiDate(date)} ที่ตำหนักผู่โถวเจ้าแม่กวนอิม ถนนพุทธมณฑลสาย ๒ — กำหนดการ จุดจอดรถ และการแต่งกาย`}
  schema={schema}
  breadcrumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'พิธีเปิดตำหนัก', href: '/opening' }]}
>
  <section class="hero zone-gilt">
    <div class="wrap hero__inner">
      <p class="hero__eyebrow">{past ? 'ประมวลภาพ' : 'กำหนดการ'}</p>
      <h1>{o.headline}</h1>
      <p class="hero__date mono">
        วัน{dayNameFull(dayOfWeek(date))}ที่ {thaiDate(date)}
      </p>
      {!past && left >= 0 && (
        <p class="hero__count">{left === 0 ? 'วันนี้' : left === 1 ? 'พรุ่งนี้' : `อีก ${left} วัน`}</p>
      )}
      <div class="hero__cta">
        <a class="btn btn--gold" href={site.maps_url} target="_blank" rel="noopener">นำทางไปตำหนัก</a>
        <a class="btn btn--plaque" href="/33-pang">ดู ๓๓ ปางก่อนมา</a>
      </div>
    </div>
  </section>

  <HoursBar compact />

  <section class="band">
    <div class="wrap wrap--narrow">
      {past && gallery.length > 0 && (
        <div class="shots">
          <h2>ภาพจากวันงาน</h2>
          <ul>
            {gallery.map((g) => (
              <li><a href={`/news/${g.id}`}>{g.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="note note--lacquer">
        <p>
          <strong>กำหนดการโดยละเอียดรอการยืนยันจากทางตำหนัก</strong>{' '}
          หน้านี้จะปรับปรุงทันทีที่ได้ข้อมูล — เวลาเริ่มพิธี ลำดับพิธีการ
          ช่วงที่ประชาชนร่วมได้ จุดจอดรถ และของที่ควรเตรียมมา
        </p>
      </div>

      <h2 class="sec">สิ่งที่ทราบแล้ว</h2>
      <dl class="facts">
        <dt>วันที่</dt>
        <dd>วัน{dayNameFull(dayOfWeek(date))}ที่ {thaiDate(date)}</dd>
        <dt>สถานที่</dt>
        <dd>{site.name_th} {site.address.full_th}</dd>
        <dt>การแต่งกาย</dt>
        <dd>สุภาพ ปิดไหล่และเข่า สีขาวหรือสีอ่อนเหมาะกับงานพิธี</dd>
        <dt>ค่าใช้จ่าย</dt>
        <dd>ไม่มี ประชาชนทั่วไปร่วมงานได้</dd>
      </dl>

      <h2 class="sec">เตรียมตัวก่อนมา</h2>
      <ul class="prep">
        <li>วันงานผู้คนจะมาก ลานจอดรถอาจเต็ม แนะนำให้มาก่อนเวลาอย่างน้อยหนึ่งชั่วโมง</li>
        <li>อ่าน<a href="/worship/how-to">วิธีไหว้</a>ไว้ก่อน จะได้ไม่ต้องกังวลหน้างาน</li>
        <li>ดู <a href="/33-pang">๓๓ ปาง</a> ล่วงหน้า แล้วเลือกปางที่ตั้งใจจะกราบ</li>
        <li>ที่ฐานของแต่ละองค์มีรหัสสำหรับสแกนดูความหมายของปางนั้นได้ทันที</li>
      </ul>

      <div class="share">
        <ShareBar title={o.headline} path="/opening" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { border: 0; border-bottom: 1px solid var(--gold-line); }
  .hero__inner { padding-block: clamp(44px, 8vw, 76px) clamp(34px, 6vw, 56px); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero__eyebrow { font: 600 12px/1.4 var(--sans); letter-spacing: .3em; padding-right: .3em; text-transform: uppercase; color: var(--gold); margin: 0 0 18px; }
  .hero h1 { font-size: clamp(27px, 5.4vw, 44px); color: var(--ink); max-width: 24ch; }
  .hero__date { margin: 20px 0 0; font-size: clamp(17px, 2.6vw, 21px); color: var(--ink-2); }
  .hero__count { margin: 10px 0 0; font-family: var(--mono); font-size: 15px; color: var(--gold); }
  .hero__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }

  .sec { font-size: 21px; margin: 44px 0 14px; }
  .shots { margin-bottom: 34px; }
  .shots ul { margin: 12px 0 0; padding-left: 1.2em; }

  .facts { margin: 0; display: grid; grid-template-columns: 130px 1fr; gap: 0; }
  .facts dt { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); padding: 13px 0; border-top: 1px solid var(--line); }
  .facts dd { margin: 0; padding: 13px 0; border-top: 1px solid var(--line); color: var(--ink-2); }
  .facts dd:last-of-type { border-bottom: 1px solid var(--line); }
  .facts dt:last-of-type { border-bottom: 1px solid var(--line); }
  @media (max-width: 520px) {
    .facts { grid-template-columns: 1fr; }
    .facts dt { padding-bottom: 0; border-bottom: 0 !important; }
    .facts dd { padding-top: 4px; border-top: 0; }
  }

  .prep { margin: 0; padding-left: 1.2em; color: var(--ink-2); }
  .prep li { margin-bottom: 9px; }
  .share { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); }
</style>
