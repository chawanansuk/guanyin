---
import '../styles/global.css';
import site, { isTemporaryHost } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { schemaOpeningHours } from '../lib/hours';
import { LANG_META, LANGS, altPath, cleanPath, useT, type Lang } from '../i18n';
import fonts from '../data/fonts.json';
import og from '../data/og.json';

interface Props {
  title: string;
  description: string;
  /** ต่อท้ายชื่อตำหนักอัตโนมัติ ตั้ง false เมื่อ title ยาวอยู่แล้ว (ไลน์ตัดที่ ~40 ตัวอักษร) */
  suffix?: boolean;
  ogImage?: string;
  noindex?: boolean;
  /** JSON-LD เพิ่มเติมของหน้านั้น ๆ เช่น Event, FAQPage */
  schema?: unknown[];
  breadcrumbs?: { label: string; href: string }[];
  bodyClass?: string;
  lang?: Lang;
  /** หน้าบทความ: แชร์ในเฟซบุ๊ก/ไลน์เป็น "บทความ" พร้อมวันที่ แทน "เว็บไซต์" */
  article?: { published: Date; modified?: Date };
}
const {
  title, description, suffix = true,
  ogImage: ogImageProp, noindex = false,
  schema = [], breadcrumbs = [], bodyClass, lang = 'th', article,
} = Astro.props;

const t = useT(lang);
const meta = LANG_META[lang];
const here = cleanPath(Astro.url.pathname);
// ภาพพรีวิวตอนแชร์: หน้าที่มีภาพเฉพาะ (npm run og สร้างไว้ใน src/data/og.json) ใช้ภาพนั้น หน้าไทยกับหน้าจีนใช้ภาพเดียวกัน
const pageKey = here.replace(/^\/zh(?=\/|$)/, '') || '/';
const ogImage = ogImageProp ?? (og.pages as Record<string, string>)[pageKey] ?? '/og/default.jpg';
const pageFonts = (fonts.pages as Record<string, { w: number; url: string; range: string }[]>)[here] ?? [];
// hreflang ให้ Google รู้ว่าหน้านี้มีอีกภาษาอยู่ที่ไหน และหน้าไหนเป็นค่าตั้งต้น
const alternates = LANGS
  .map((l) => ({ l, p: altPath(here, l) }))
  .filter((x): x is { l: Lang; p: string } => x.p !== null);

const fullTitle = suffix ? `${title} · ${lang === 'zh' ? site.name_zh : site.name_th}` : title;
const canonical = new URL(here, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const place = {
  '@context': 'https://schema.org',
  '@type': 'PlaceOfWorship',
  '@id': `${site.url}/#shrine`,
  // หน้าจีนส่งชื่อและคำอธิบายภาษาจีน ชื่ออีกสองภาษาอยู่ใน alternateName
  name: lang === 'zh' ? site.name_zh : site.name_th,
  alternateName: lang === 'zh' ? [site.name_th, site.name_en] : [site.name_zh, site.name_en],
  description: lang === 'zh' ? site.tagline_zh : site.tagline,
  url: site.url,
  image: ogUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postal_code,
    addressCountry: site.address.country,
  },
  // พิกัดยังเป็นค่าประมาณ จึงยังไม่ส่งเข้า structured data —
  // ส่งพิกัดผิดแย่กว่าไม่ส่งเลย เพราะ Google จะปักหมุดผิดที่
  // ให้ตั้ง geo.verified = true ใน site.json เมื่อได้พิกัดจริงจากหมุดของตำหนัก
  ...(site.geo.verified
    ? { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } }
    : {}),
  hasMap: site.maps_url,
  ...(site.phone ? { telephone: site.phone } : {}),
  openingHoursSpecification: schemaOpeningHours().map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.dayOfWeek,
    opens: h.opens,
    closes: h.closes,
  })),
};

const crumbs = breadcrumbs.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.label,
        item: new URL(b.href, site.url).href,
      })),
    }]
  : [];

const graphs = [place, ...crumbs, ...schema];
---
<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isTemporaryHost
      ? <meta name="robots" content="noindex, nofollow" />
      : noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString().slice(0, 10)} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString().slice(0, 10)} />}
    <meta property="og:site_name" content={lang === "zh" ? site.name_zh : site.name_th} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={LANG_META[a.l].htmlLang} href={new URL(a.p, site.url).href} />
    ))}
    {alternates.length > 1 && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.l === 'th')!.p, site.url).href} />
    )}

    {/* ฟอนต์อยู่ในเว็บเอง (public/fonts สร้างด้วย npm run fonts) โหลดล่วงหน้าเฉพาะสองตัวที่ทุกหน้าใช้ */}
    {fonts.preload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {/* ตัวอักษรจีนเฉพาะหน้านี้ (ที่ไม่อยู่ในชุดกลางของ fonts.css) */}
    {pageFonts.length > 0 && (
      <style set:html={pageFonts.map((f) =>
        `@font-face{font-family:'Noto Serif TC';font-style:normal;font-weight:${f.w};font-display:swap;src:url(${f.url}) format('woff2');unicode-range:${f.range}}`
      ).join('')} />
    )}

    {graphs.map((g) => (
      <script type="application/ld+json" set:html={JSON.stringify(g)} />
    ))}
    {/* สถิติผู้เข้าชมแบบไม่ใช้คุกกี้ จึงไม่ต้องขึ้นแบนเนอร์ขอความยินยอม
        ใช้นับสัดส่วน ?src=qr ว่าคนเข้าจากป้ายในตำหนักมากแค่ไหน */}
    {site.analytics.provider === 'plausible' && site.analytics.domain && (
      <script defer data-domain={site.analytics.domain} src="https://plausible.io/js/script.js"></script>
    )}
    {site.analytics.provider === 'umami' && site.analytics.domain && (
      <script defer data-website-id={site.analytics.domain} src="https://cloud.umami.is/script.js"></script>
    )}
    {/* Vercel Web Analytics: ต้องกดเปิดที่แดชบอร์ด Vercel → โปรเจกต์ → Analytics ด้วย ก่อนเปิดสคริปต์ตอบ 404 ไม่มีผลกับหน้าเว็บ */}
    {site.analytics.provider === 'vercel' && import.meta.env.PROD && (
      <script defer src="/_vercel/insights/script.js"></script>
    )}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{t('skip')}</a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    {/* นับวันในเครื่องของคนดู ไม่พึ่งเวลาที่สร้างเว็บ
        เว็บเป็น HTML คงที่ ถ้าไม่ได้สร้างใหม่ทุกวัน "อีก N วัน" จะค้าง
        ทุกจุดที่มี data-days จะถูกคำนวณใหม่ตามเวลาไทยตอนเปิดหน้า
        และกล่องที่มี data-days-hide-past จะซ่อนตัวเองเมื่อวันนั้นผ่านไปแล้ว */}
    <script is:inline>
      (function () {
        var L = {
          th: { today: 'วันนี้', tmr: 'พรุ่งนี้', past: 'ผ่านไปแล้ว', on: 'กำลังจัดอยู่', in: function (n) { return 'อีก ' + n + ' วัน'; } },
          zh: { today: '今日', tmr: '明日', past: '已過', on: '進行中', in: function (n) { return '尚餘 ' + n + ' 天'; } }
        };
        var bkk, today;
        try {
          bkk = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Bangkok' }));
          today = Date.UTC(bkk.getFullYear(), bkk.getMonth(), bkk.getDate());
        } catch (e) { return; }
        function days(iso) { var p = iso.split('-'); return Math.round((Date.UTC(+p[0], +p[1] - 1, +p[2]) - today) / 864e5); }
        var els = document.querySelectorAll('[data-days]');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          var lang = L[el.getAttribute('data-days-lang') || document.documentElement.lang.slice(0, 2)] || L.th;
          var n = days(el.getAttribute('data-days'));
          var end = el.getAttribute('data-days-end');
          var ne = end ? days(end) : n;
          el.textContent = n > 1 ? lang.in(n) : n === 1 ? lang.tmr : n === 0 ? lang.today : ne >= 0 ? lang.on : lang.past;
          var box = el.closest('[data-days-hide-past]');
          if (box && ne < 0) box.hidden = true;
        }
        // รายการวันสำคัญ: แถวที่ผ่านไปแล้วย้ายไปกลุ่ม "ผ่านไปแล้ว" (ถ้ามี) หรือซ่อน แล้วแสดงไม่เกินจำนวนที่กำหนด
        var lists = document.querySelectorAll('[data-days-list]');
        for (var a = 0; a < lists.length; a++) {
          var list = lists[a];
          var into = list.getAttribute('data-days-past-into');
          var dest = into && document.querySelector(into);
          var rows = list.querySelectorAll('[data-days-row]');
          for (var b = 0; b < rows.length; b++) {
            if (days(rows[b].getAttribute('data-days-row')) >= 0) continue;
            if (dest) { rows[b].classList.add(dest.getAttribute('data-days-past-class') || 'evt__row--past'); dest.insertBefore(rows[b], dest.firstChild); }
            else rows[b].hidden = true;
          }
          var lim = +list.getAttribute('data-days-limit');
          if (lim) {
            var left = list.querySelectorAll('[data-days-row]'), shown = 0;
            for (var c = 0; c < left.length; c++) { if (days(left[c].getAttribute('data-days-row')) < 0) continue; shown++; left[c].hidden = shown > lim; }
          }
          if (dest) {
            var box = dest.closest('[data-days-past-box]');
            var cnt = box && box.querySelector('[data-days-past-count]');
            var total = dest.querySelectorAll('[data-days-row], li').length;
            if (box && total) box.hidden = false;
            if (cnt) cnt.textContent = total;
          }
        }
      })();
    </script>
  </body>
</html>
