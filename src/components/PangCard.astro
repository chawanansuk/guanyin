---
import PangArt from './PangArt.astro';
import { pangNo } from '../lib/format';
import { displayName, type Pang } from '../lib/pang';
import { useT, withLang, type Lang } from '../i18n';

interface Props { pang: Pang; priority?: boolean; lang?: Lang }
const { pang, priority = false, lang = 'th' } = Astro.props;
const d = pang.data;
const t = useT(lang);
// ฝั่งจีนให้ชื่อจีนเป็นบรรทัดหลัก เพราะเป็นชื่อที่ผู้อ่านจีนใช้จริง
const primary = lang === 'zh' ? d.name_zh : displayName(pang);
const secondary = lang === 'zh' ? '' : d.name_zh;
---
<a
  class:list={['pang-card sheen reveal', !d.enshrined && 'pang-card--pending']}
  href={withLang(`/33-pang/${d.slug}`, lang)}
  data-wishes={d.wishes.join(' ')}
  data-order={d.order}
>
  <PangArt
    photo={d.photo} order={d.order} nameTh={displayName(pang)} nameZh={d.name_zh}
    enshrined={d.enshrined} priority={priority} lang={lang}
  />
  <span class="pang-card__body">
    <span class="pang-card__no mono">{pangNo(d.order)}</span>
    <span class:list={['pang-card__th', lang === 'zh' && 'han']}>{primary}</span>
    {secondary && <span class="pang-card__zh han">{secondary}</span>}
    {/* วลีสั้นบอกแก่นของปาง — ตาราง ๓๓ ใบที่มีแต่ชื่อ กวาดสายตาหาไม่เจอว่า
        ปางไหนตรงกับเรื่องที่กำลังจะขอ */}
    {lang !== 'zh' && d.tagline && <span class="pang-card__tag-line">{d.tagline}</span>}
    {!d.enshrined && <span class="pang-card__tag">{t('pang.pending')}</span>}
  </span>
</a>

<style>
  .pang-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    /* เส้นตารางมาจากตัวการ์ดเอง ไม่ใช่พื้นหลังของตาราง
       เพราะ ๓๓ ปางไม่ลงตัวกับจำนวนคอลัมน์ ช่องที่เหลือจะได้ไม่มีสีพื้นค้างไว้ */
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow .45s var(--ease-lux), transform .45s var(--ease-lux);
    position: relative;
  }
  .pang-card:hover {
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 2px 3px rgba(0, 0, 0, .16),
      0 8px 16px rgba(0, 0, 0, .12),
      0 22px 44px rgba(0, 0, 0, .14);
    transform: translateY(-4px);
    z-index: 1;
  }
  .pang-card:hover .pang-card__th { color: var(--lacquer); }

  .pang-card__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px 16px;
  }
  .pang-card__no { font-size: 11.5px; color: var(--gold); letter-spacing: .24em; }
  .pang-card__th { font-family: var(--display); font-size: 17px; font-weight: 500; line-height: 1.45; transition: color .3s var(--ease-lux); }
  .pang-card__zh { font-size: 14px; color: var(--ink-3); }
  .pang-card__tag-line {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--lacquer-deep);
  }

  .pang-card__tag {
    align-self: flex-start;
    margin-top: 6px;
    padding: 1px 9px;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .pang-card--pending :global(.pang-art) { opacity: .82; }
  /* ในตาราง ๓๓ ใบ คำว่า "รอภาพถ่าย" ซ้ำกันทุกใบจะกลายเป็นเสียงรบกวน
     เก็บไว้ให้เห็นเฉพาะภาพใหญ่ในหน้าปาง */
  .pang-card :global(.pang-case__hint) { display: none; }
  .pang-card--pending :global(.pang-case__hint) { display: block; }
</style>
