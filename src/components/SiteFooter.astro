---
import site from '../lib/site';
import { hoursSummary } from '../lib/hours';
import LangSwitch from './LangSwitch.astro';
import ShrineMark from './ShrineMark.astro';
import { useT, withLang, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'th' } = Astro.props;
const t = useT(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = lang === 'zh' ? new Date().getFullYear() : new Date().getFullYear() + 543;

const LINKS = lang === 'zh'
  ? [
      { href: '/zh/33-pang', label: '三十三觀音' },
      { href: '/zh/worship/how-to', label: '參拜方式' },
      { href: '/zh/calendar', label: '節日曆' },
      { href: '/zh/faq', label: '常見問題' },
      { href: '/zh/contact', label: '聯絡本堂' },
    ]
  : [
      { href: '/33-pang', label: '๓๓ ปางทั้งหมด' },
      { href: '/worship/how-to', label: 'วิธีไหว้' },
      { href: '/worship/by-wish', label: 'ขอพรเรื่องไหน ไหว้ปางใด' },
      { href: '/calendar', label: 'ปฏิทินวันสำคัญ' },
      { href: '/faq', label: 'คำถามที่พบบ่อย' },
      { href: '/contact', label: 'ติดต่อตำหนัก' },
    ];
---
<footer class="site-foot zone-dark zone-dark--ox">
  <div class="wrap site-foot__inner">
    <div class="site-foot__brand">
      <ShrineMark class="site-foot__mark" title={site.name_th} />
      <div class="site-foot__zh han foil">{site.name_zh}</div>
      <div class="site-foot__th">{lang === 'zh' ? '佛城二段' : site.name_th}</div>
      <p class="site-foot__couplet han">
        {site.couplet.map((c) => <span>{c.zh}</span>)}
      </p>
    </div>

    <div class="site-foot__cols">
      <div>
        <h2>{t('foot.place')}</h2>
        <p>{lang === 'zh' ? site.address.full_zh : site.address.full_th}</p>
        <p class="mono">{hoursSummary()}</p>
        <p><a href={site.maps_url} target="_blank" rel="noopener">{t('cta.maps')}</a></p>
      </div>
      <div>
        <h2>{t('foot.links')}</h2>
        <ul>
          {LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="site-foot__lang">
      <LangSwitch lang={lang} path={path} />
    </div>
    <p class="site-foot__legal">{t('foot.notice')}</p>
    <p class="site-foot__legal">© {year} {lang === 'zh' ? site.name_zh : site.name_th}</p>
  </div>
</footer>

<style>
    /* ท้ายเว็บเข้าระบบเดียวกับหัวเว็บ — พื้นรักเข้ม ตัวอักษรทอง
     พื้นแดงสดทำให้ชื่อทองคำเปลวจมหายไป เพราะคอนทราสต์ระหว่างทองกับแดงสดต่ำ */
  .site-foot {
    border: 0;
    border-top: 1px solid var(--gold-line);
    background: linear-gradient(180deg, #1B0A0D 0%, #0B0708 100%);
    margin-top: 0;
  }
  .site-foot::before { display: none; }
  .site-foot__inner { padding-block: 48px 56px; display: flex; flex-direction: column; gap: 28px; }

  .site-foot__brand :global(.site-foot__mark) { width: 58px; color: var(--gold); margin-bottom: 18px; }
  .site-foot__zh { font-size: 30px; font-weight: 700; letter-spacing: .2em; padding-left: .2em; line-height: 1.2; }
  .site-foot__th { font-family: var(--display); font-size: 17px; letter-spacing: .02em; color: var(--ink-2); margin-top: 6px; }
  .site-foot__couplet {
    display: flex; flex-direction: column; gap: 4px;
    margin: 16px 0 0; font-size: 14.5px; color: var(--ink-3); letter-spacing: .16em;
  }

  .site-foot__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px 40px; }
  .site-foot__cols h2 {
    font-family: var(--sans); font-size: 11.5px; font-weight: 600;
    letter-spacing: .3em; padding-right: .3em; text-transform: uppercase;
    color: var(--gold-bright); margin-bottom: 12px;
  }
  .site-foot__cols p, .site-foot__cols li { font-size: 16px; line-height: 1.75; color: var(--ink-2); }
  .site-foot__cols p + p { margin-top: 6px; }
  .site-foot__cols ul { list-style: none; margin: 0; padding: 0; }
  .site-foot__cols li + li { margin-top: 4px; }
  .site-foot a { color: var(--ink-2); text-decoration-color: var(--gold-line); text-underline-offset: 4px; transition: color .3s var(--ease-lux); }
  .site-foot a:hover { color: var(--gold); text-decoration-color: var(--gold-bright); }

  .site-foot__lang { padding-top: 22px; border-top: 1px solid var(--gold-line); }
  .site-foot__legal { font-size: 14px; line-height: 1.7; color: var(--ink-3); max-width: 62ch; margin: 0; }
</style>
