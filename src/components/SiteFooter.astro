---
import site from '../lib/site';
import { hoursSummary } from '../lib/hours';
import LangSwitch from './LangSwitch.astro';
import ShrineMark from './ShrineMark.astro';
import { useT, withLang, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'th' } = Astro.props;
const t = useT(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = lang === 'zh' ? new Date().getFullYear() : new Date().getFullYear() + 543;

const LINKS = lang === 'zh'
  ? [
      { href: '/zh/33-pang', label: '三十三觀音' },
      { href: '/zh/worship/how-to', label: '參拜方式' },
      { href: '/zh/calendar', label: '節日曆' },
      { href: '/zh/faq', label: '常見問題' },
      { href: '/zh/contact', label: '聯絡本堂' },
    ]
  : [
      { href: '/33-pang', label: '๓๓ ปางทั้งหมด' },
      { href: '/worship/how-to', label: 'วิธีไหว้' },
      { href: '/worship/by-wish', label: 'ขอพรเรื่องไหน ไหว้ปางใด' },
      { href: '/calendar', label: 'ปฏิทินวันสำคัญ' },
      { href: '/faq', label: 'คำถามที่พบบ่อย' },
      { href: '/contact', label: 'ติดต่อตำหนัก' },
    ];
---
<footer class="site-foot zone-plaque">
  <div class="wrap site-foot__inner">
    <div class="site-foot__brand">
      <ShrineMark class="site-foot__mark" title={site.name_th} />
      <div class="site-foot__zh han foil">{site.name_zh}</div>
      <div class="site-foot__th">{lang === 'zh' ? '佛城二段' : site.name_th}</div>
      <p class="site-foot__couplet han">
        {site.couplet.map((c) => <span>{c.zh}</span>)}
      </p>
    </div>

    <div class="site-foot__cols">
      <div>
        <h2>{t('foot.place')}</h2>
        <p>{lang === 'zh' ? site.address.full_zh : site.address.full_th}</p>
        <p class="mono">{hoursSummary(lang)}</p>
        <p><a href={site.maps_url} target="_blank" rel="noopener">{t('cta.maps')}</a></p>
      </div>
      <div>
        <h2>{t('foot.links')}</h2>
        <ul>
          {LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="site-foot__lang">
      <LangSwitch lang={lang} path={path} />
    </div>
    <p class="site-foot__legal">{t('foot.notice')}</p>
    <p class="site-foot__legal">© {year} {lang === 'zh' ? site.name_zh : site.name_th}</p>
  </div>
</footer>

<style>
  /* ท้ายเว็บเป็นป้ายชาดปิดท้ายหน้า เหมือนป้ายแดงบนอาคาร
     ขลิบทองสองเส้นด้านบนอย่างคิ้วป้าย พื้นและตัวอักษรมาจากโซน .zone-plaque */
  .site-foot {
    border: 0;
    border-top: 2px solid var(--gold-bright);
    box-shadow: inset 0 3px 0 -1px rgba(246, 227, 176, .34);
    margin-top: 0;
  }

  .site-foot__inner { padding-block: var(--space-12) 56px; display: flex; flex-direction: column; gap: 28px; }

  .site-foot__brand :global(.site-foot__mark) { width: 58px; color: var(--gold); margin-bottom: var(--space-4); }
  .site-foot__zh { color: var(--gold-bright); font-size: var(--fs-h2); font-weight: 700; letter-spacing: .2em; padding-left: .2em; line-height: 1.2; }
  .site-foot__th { font-family: var(--display); font-size: var(--fs-md); letter-spacing: .02em; color: var(--ink-2); margin-top: var(--space-2); }
  .site-foot__couplet {
    display: flex; flex-direction: column; gap: var(--space-1);
    margin: var(--space-4) 0 0; font-size: var(--fs-sm); color: var(--ink-3); letter-spacing: .16em;
  }

  .site-foot__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px 40px; }
  .site-foot__cols h2 {
    font-family: var(--sans); font-size: var(--fs-caption); font-weight: 600;
    letter-spacing: .3em; padding-right: .3em; text-transform: uppercase;
    color: var(--gold); margin-bottom: var(--space-3);
  }
  .site-foot__cols p, .site-foot__cols li { font-size: var(--fs-md); line-height: 1.75; color: var(--ink-2); }
  .site-foot__cols p + p { margin-top: var(--space-2); }
  .site-foot__cols ul { list-style: none; margin: 0; padding: 0; }
  .site-foot__cols li + li { margin-top: var(--space-1); }
  .site-foot a { color: var(--ink); text-decoration-color: var(--gold-line); text-underline-offset: 4px; transition: color .3s var(--ease-lux); }
  .site-foot a:hover { color: var(--gold-bright); text-decoration-color: var(--gold-bright); }

  .site-foot__lang { padding-top: var(--space-6); border-top: 1px solid var(--gold-line); }

  /* จอกว้าง: ตราและชื่ออยู่ซ้าย ที่ตั้งกับทางลัดกระจายเต็มความกว้างตามแบบ V2
     เดิมทุกอย่างกองอยู่ครึ่งซ้าย เหลือพื้นที่ว่างทางขวาเกือบครึ่งหน้า */
  @media (min-width: 760px) {
    .site-foot__inner {
      display: grid;
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      gap: var(--space-4) clamp(var(--space-12), 7vw, 96px);
      align-items: start;
    }
    .site-foot__cols { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
    .site-foot__lang, .site-foot__legal { grid-column: 1 / -1; }
    .site-foot__lang { margin-top: var(--space-8); }
  }
  .site-foot__legal { font-size: var(--fs-sm); line-height: 1.7; color: var(--ink-3); max-width: 62ch; margin: 0; }
</style>
