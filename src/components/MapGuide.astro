---
/**
 * คลิปนำทางมาตำหนัก — แผนที่ภาพ ๕ จุดสังเกต พร้อมเพลงประกอบ
 *
 * ไม่เล่นเอง: คลิปมีเสียง และคนที่เปิดหน้านี้ส่วนใหญ่อยู่บนมือถือกำลังจะออกเดินทาง
 * จึงให้กดเล่นเองทุกครั้ง พอกดแล้วเปิดแถบควบคุมของเบราว์เซอร์ให้เลื่อนดูทีละจุดได้
 *
 * ทำงานได้แม้สคริปต์ไม่รัน: HTML ส่งมาพร้อมแถบควบคุมของเบราว์เซอร์ และปุ่มทับภาพซ่อนอยู่
 * สคริปต์ (ES5 แบบ inline เพื่อให้เบราว์เซอร์ในแอป LINE/Facebook รุ่นเก่ารันได้) จึงค่อยซ่อนแถบควบคุม
 * แล้วแสดงปุ่ม ถ้าเล่นไม่ได้ ปุ่มจะหายไปให้เหลือแถบควบคุมเดิม และขึ้นลิงก์เปิดไฟล์ตรง
 * ข้อความในคลิปเป็นภาษาไทยฝังในภาพ เนื้อหาตรงกับหัวข้อ "เดินทางด้วยรถยนต์" ด้านล่าง
 * ต้นฉบับ 1080×1920 อยู่ใน print/ (ไม่ commit) ไฟล์เว็บย่อเหลือ 720×1280
 */
import ShrineMark from './ShrineMark.astro';

const FILE = '/video/map-guide.mp4';
const BYTES = 2_536_840;
const SECONDS = 37;
const mb = (BYTES / 1_048_576).toFixed(1);
---
<section class="mapvid" aria-labelledby="mapvid-h">
  <figure class="mapvid__fig">
    <div class="mapvid__frame">
      <video
        class="mapvid__el"
        playsinline
        controls
        preload="none"
        poster="/video/map-guide-poster.jpg"
        width="720"
        height="1280"
        aria-label="คลิปนำทางมาตำหนักผู่โถว ๕ จุดสังเกต"
      >
        <source src={FILE} type="video/mp4" />
      </video>
      <button class="mapvid__play" type="button" data-mapvid-play hidden>
        <span class="mapvid__mark"><ShrineMark title="เล่นคลิปนำทาง" /></span>
        <span class="mapvid__label">กดเพื่อเล่น</span>
      </button>
    </div>
  </figure>

  <div class="mapvid__text">
    <p class="eyebrow eyebrow--marked">คลิปนำทาง</p>
    <h2 id="mapvid-h">ดูทางมาก่อนออกจากบ้าน</h2>
    <p>
      คลิปสั้น {SECONDS} วินาที พาดูจุดสังเกตทีละจุด ตั้งแต่ถนนพุทธมณฑลสาย ๒
      ซอย ๑๑ กับซอย ๑๒ ร้านยางสายสอง ทางกลับรถสำหรับคนที่มาจากถนนบรมราชชนนี
      จนถึงประตูตำหนักด้านในสุดของลานจอดรถ
    </p>
    <p class="muted small">มีเพลงประกอบ เปิดเสียงได้ · ไฟล์ {mb} MB · แผนผังประกอบ ไม่ใช่มาตราส่วนจริง</p>
    <p class="mapvid__fail" data-mapvid-fail hidden>
      เครื่องนี้เล่นคลิปในหน้าเว็บไม่ได้ <a href={FILE} target="_blank" rel="noopener">เปิดคลิปในหน้าต่างใหม่</a>
    </p>
    <p class="mapvid__links">
      <a href={FILE} target="_blank" rel="noopener">เปิดคลิปเต็มจอ</a>
      <span aria-hidden="true"> · </span>
      <a href={FILE} download="putuo-guanyin-map.mp4">ดาวน์โหลดไว้ส่งต่อ</a>
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    var frames = document.querySelectorAll('.mapvid__frame');
    for (var i = 0; i < frames.length; i++) (function (frame) {
      var video = frame.querySelector('video');
      var btn = frame.querySelector('[data-mapvid-play]');
      var fail = frame.closest('.mapvid').querySelector('[data-mapvid-fail]');
      if (!video || !btn) return;
      // เล่นไม่ได้ → ทิ้งปุ่ม คืนแถบควบคุมของเบราว์เซอร์ และบอกทางออก
      var giveUp = function () {
        frame.setAttribute('data-playing', 'true');
        btn.hidden = true;
        video.controls = true;
        if (fail) fail.hidden = false;
      };
      video.addEventListener('error', giveUp, true);
      var src = video.querySelector('source');
      if (src) src.addEventListener('error', giveUp);
      video.controls = false;
      btn.hidden = false;
      btn.addEventListener('click', function () {
        frame.setAttribute('data-playing', 'true');
        video.controls = true;
        var p;
        try { p = video.play(); } catch (err) { giveUp(); return; }
        if (p && p.catch) p.catch(function (err) {
          // ผู้ใช้กดเองแล้ว จึงไม่ใช่เรื่องนโยบายเล่นอัตโนมัติ ให้เหลือแถบควบคุมไว้กดซ้ำได้
          btn.hidden = true;
          if (err && err.name === 'NotSupportedError' && fail) fail.hidden = false;
        });
      });
    })(frames[i]);
  })();
</script>

<style>
  .mapvid {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: var(--space-8) var(--space-12);
    align-items: center;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .mapvid { grid-template-columns: 1fr; gap: var(--space-6); }
    .mapvid__fig { width: min(100%, 340px); margin-inline: auto; }
  }

  .mapvid__fig { margin: 0; }
  .mapvid__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    background: #F2E6CE;
    box-shadow:
      0 0 0 1px rgba(142, 106, 22, .34),
      0 0 0 7px #FFFDF8,
      0 0 0 9px rgba(216, 169, 63, .55),
      0 20px 44px -20px rgba(90, 62, 20, .38);
  }
  .mapvid__el { width: 100%; height: 100%; object-fit: cover; display: block; }

  .mapvid__play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    border: 0;
    cursor: pointer;
    background: linear-gradient(180deg, rgba(40, 8, 6, .06) 0%, rgba(40, 8, 6, .4) 100%);
    transition: opacity .4s var(--ease-lux);
  }
  .mapvid__mark {
    width: 74px;
    display: grid;
    place-items: center;
    padding: var(--space-3);
    border-radius: 50%;
    color: var(--gold-bright);
    background: linear-gradient(175deg, var(--plaque) 0%, var(--plaque-2) 100%);
    box-shadow: 0 0 0 1px var(--gold-bright), 0 10px 26px rgba(40, 8, 6, .45);
    transition: transform .45s var(--ease-lux);
  }
  .mapvid__label {
    font: 600 var(--fs-label)/1.4 var(--sans);
    letter-spacing: .22em;
    padding-left: .22em;
    color: #FFF7E4;
    text-shadow: 0 1px 3px rgba(40, 8, 6, .8);
  }
  .mapvid__play:hover .mapvid__mark { transform: scale(1.06); }
  .mapvid__frame[data-playing="true"] .mapvid__play { opacity: 0; pointer-events: none; }

  .mapvid__text h2 { font-size: var(--fs-h3); margin: 8px 0 12px; }
  .mapvid__text p { color: var(--ink-2); max-width: var(--measure); }
  .mapvid__text p + p { margin-top: 10px; }
  .mapvid__links a { display: inline-block; padding: 10px 0; min-height: 44px; }
  .mapvid__fail { color: var(--lacquer); font-weight: 500; }
  .mapvid__play[hidden] { display: none; }
</style>
