---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  narrow?: boolean;
}
const { eyebrow, title, lede, narrow = false } = Astro.props;
---
<div class="page-hero zone-gilt">
  <div class:list={['wrap', narrow && 'wrap--narrow']}>
    {eyebrow && <p class="eyebrow eyebrow--marked">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>

<style>
  /* หัวเรื่องของหน้า ต่อจากแถบเมนูเป็นก้อนมืดก้อนเดียว
     เนื้อหาด้านล่างยังเป็นพื้นสว่าง เพราะเป็นส่วนที่ต้องอ่านยาว */
  .page-hero {
    padding-block: clamp(38px, 6.4vw, 66px) clamp(32px, 4.6vw, 48px);
    border-bottom: 1px solid var(--gold-line);
  }
  .page-hero .eyebrow { margin-bottom: 14px; }
  .page-hero h1 { color: var(--ink); }
  .page-hero h1 + .lede { margin-top: 16px; }
  .page-hero .lede { font-family: var(--display); font-weight: 300; color: var(--ink-2); }
  .page-hero :global(.mono) { color: var(--gold); }
</style>
