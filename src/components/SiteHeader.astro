---
import site from '../data/site.json';

/** เมนู ๕ ช่อง — ตัดเหลือเท่าที่คนใช้จริง เมนูยาวทำให้เลือกไม่ถูก */
const NAV = [
  { href: '/about', label: 'เกี่ยวกับตำหนัก' },
  { href: '/33-pang', label: '๓๓ ปาง' },
  { href: '/worship', label: 'การบูชา' },
  { href: '/calendar', label: 'ปฏิทิน' },
  { href: '/visit', label: 'การเดินทาง' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isOn = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-head">
  <div class="site-head__bar plaque">
    <div class="wrap site-head__bar-inner">
      <a href="/" class="brand">
        <span class="brand__zh han">{site.name_zh}</span>
        <span class="brand__th">{site.name_th}</span>
      </a>
      <a class="btn btn--plaque site-head__nav-btn" href={site.maps_url} target="_blank" rel="noopener">
        นำทางไปตำหนัก
      </a>
    </div>
  </div>

  <nav class="site-nav" aria-label="เมนูหลัก">
    <div class="wrap site-nav__inner">
      <ul class="site-nav__list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isOn(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-head__bar {
    border: 0;
    border-bottom: 3px solid var(--gold-bright);
    box-shadow: inset 0 -1px 0 var(--plaque-line);
  }
  .site-head__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding-block: 10px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
    color: var(--plaque-ink);
  }
  .brand__zh { font-size: 21px; font-weight: 700; letter-spacing: .16em; line-height: 1.2; }
  .brand__th { font-family: var(--serif); font-size: 13.5px; color: var(--plaque-ink-2); line-height: 1.3; }

  .site-head__nav-btn { flex: none; font-size: 15.5px; min-height: 44px; padding-inline: 16px; }

  .site-nav {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-nav__inner { padding-inline: 0; }
  .site-nav__list {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav__list::-webkit-scrollbar { display: none; }
  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 14px;
    color: var(--ink-2);
    font-size: 16px;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .site-nav__list li:first-child a { padding-left: 0; }
  .site-nav__list a:hover { color: var(--ink); }
  .site-nav__list a[aria-current="page"] {
    color: var(--lacquer);
    border-bottom-color: var(--lacquer);
    font-weight: 500;
  }

  @media (max-width: 520px) {
    .brand__zh { font-size: 18px; }
    .site-head__nav-btn { font-size: 14.5px; padding-inline: 13px; }
  }
</style>
