---
import site from '../lib/site';
import LangSwitch from './LangSwitch.astro';
import ShrineMark from './ShrineMark.astro';
import { useT, withLang, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'th' } = Astro.props;
const t = useT(lang);

/** เมนู ๕ ช่อง — ตัดเหลือเท่าที่คนใช้จริง เมนูยาวทำให้เลือกไม่ถูก
 *  ฝั่งจีนยังไม่มีหน้า /worship รวม จึงชี้ตรงไปหน้าวิธีไหว้ที่แปลแล้ว */
// short = คำสั้นสำหรับจอแคบ — จอ 390px ใส่คำเต็มแล้ว "การเดินทาง" หลุดขอบ
// โดยไม่มีสัญญาณว่าเลื่อนได้ หน้าที่คนมาใหม่ต้องการที่สุดจึงหาไม่เจอ
const NAV = lang === 'zh'
  ? [
      { href: '/zh/about', label: t('nav.about'), short: '本堂' },
      { href: '/zh/33-pang', label: t('nav.pang'), short: '三十三觀音' },
      { href: '/zh/worship/how-to', label: t('nav.worship'), short: '參拜' },
      { href: '/zh/calendar', label: t('nav.calendar'), short: '節日' },
      { href: '/zh/visit', label: t('nav.visit'), short: '交通' },
    ]
  : [
      { href: '/about', label: t('nav.about'), short: 'ตำหนัก' },
      { href: '/33-pang', label: t('nav.pang'), short: '๓๓ ปาง' },
      { href: '/worship', label: t('nav.worship'), short: 'บูชา' },
      { href: '/calendar', label: t('nav.calendar'), short: 'ปฏิทิน' },
      { href: '/visit', label: t('nav.visit'), short: 'เดินทาง' },
    ];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isOn = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-head">
  <div class="site-head__bar">
    <div class="wrap site-head__bar-inner">
      <a href={withLang('/', lang)} class="brand">
        <ShrineMark class="brand__mark" title={site.name_th} />
        <span class="brand__text">
          <span class="brand__zh han foil">{site.name_zh}</span>
          <span class="brand__th">{lang === 'zh' ? '佛城二段' : site.name_th}</span>
        </span>
      </a>
      <div class="site-head__right">
        <LangSwitch lang={lang} path={path} />
        <a class="btn btn--plaque site-head__nav-btn" href={site.maps_url} target="_blank" rel="noopener">
          {t('cta.directions')}
        </a>
      </div>
    </div>
  </div>

  <nav class="site-nav" aria-label={t('nav.menu')}>
    <div class="wrap site-nav__inner">
      <ul class="site-nav__list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isOn(item.href) ? 'page' : undefined} aria-label={item.label}>
              <span class="nav-long">{item.label}</span><span class="nav-short" aria-hidden="true">{item.short}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  /* หัวเว็บเป็นผนังปูนขาวเหมือนตัวอาคาร มีเส้นทองคาดบนล่างอย่างคิ้วกรอบ
     ชื่อตำหนักเป็นสีชาดตามป้ายจริง ไม่ใช่ทองบนพื้นมืด */
  .site-head {
    background: linear-gradient(180deg, #FFFDF8 0%, #FBF5EA 100%);
    border-bottom: 1px solid var(--gold-line);
    box-shadow: inset 0 3px 0 -1px var(--gold-bright);
  }
  .site-head__bar { border-bottom: 1px solid var(--line); }
  .site-head__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    min-height: 60px;
    padding-block: 8px;
    flex-wrap: nowrap;
  }
  .site-head__right { display: flex; align-items: center; gap: 6px 12px; flex: none; }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--lacquer);
  }
  .brand__text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  /* ตราศาลา — ขนาดเท่าความสูงของชื่อสองบรรทัดรวมกัน จะได้อ่านเป็นชิ้นเดียว */
  .brand :global(.brand__mark) { width: 42px; flex: none; color: var(--gold); transition: color .3s var(--ease-lux); }
  .brand:hover :global(.brand__mark) { color: var(--lacquer); }
  /* ชื่อจีนสีชาด ตรงกับป้ายบนอาคาร — ทองบนพื้นครีมอ่านไม่ขึ้นที่ขนาดนี้ */
  .brand__zh { font-size: 21px; font-weight: 700; letter-spacing: .16em; padding-left: .16em; line-height: 1.25; color: var(--lacquer); }
  .brand__th { font-family: var(--display); font-size: 13.5px; letter-spacing: .02em; color: var(--ink-2); line-height: 1.35; }

  .site-head__nav-btn { flex: none; font-size: 15.5px; min-height: 44px; padding-inline: 16px; }
  /* มือถือ: ปุ่มนำทางอยู่ในแถบเวลาเปิด–ปิดใต้ฮีโร่แล้ว
     ซ้ำในหัวเว็บอีกจะดันเนื้อหาลงไปอีกแถบทั้งแถบ */
  @media (max-width: 899px) { .site-head__nav-btn { display: none; } }

  .site-nav {
    background: #FFFDF8;
    border-bottom: 1px solid var(--line-strong);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-nav__inner { padding-inline: 0; position: relative; }
  /* ขอบขวาจางลง บอกว่าเมนูเลื่อนต่อได้ — ไม่งั้นรายการที่ถูกตัดจะดูเหมือนไม่มีอยู่ */
  .site-nav__inner::after {
    content: "";
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 44px;
    background: linear-gradient(90deg, rgba(255, 253, 248, 0), #FFFDF8 78%);
    pointer-events: none;
  }
  @media (min-width: 640px) { .site-nav__inner::after { display: none; } }
  .site-nav__list {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav__list::-webkit-scrollbar { display: none; }
  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding-inline: 15px;
    color: var(--ink-2);
    font-size: 16px;
    letter-spacing: .02em;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color .3s var(--ease-lux), border-color .3s var(--ease-lux);
  }
  .site-nav__list li:first-child a { padding-left: 0; }
  .site-nav__list a:hover { color: var(--lacquer); }
  .site-nav__list a[aria-current="page"] {
    color: var(--lacquer);
    border-bottom-color: var(--lacquer);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .brand__zh { font-size: 18px; }
    .brand__th { font-size: 12.5px; }
    .brand :global(.brand__mark) { width: 36px; }
    .site-nav__list a { min-height: 46px; padding-inline: 10px; font-size: 15.5px; }
    .nav-long { display: none; }
  }
  .nav-short { display: none; }
  @media (max-width: 560px) { .nav-short { display: inline; } }
</style>
