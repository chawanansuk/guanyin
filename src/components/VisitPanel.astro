---
import site from '../lib/site';
import { groupedHours, closedDays } from '../lib/hours';
import { dayNameShort } from '../lib/format';
import { useT, withLang, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'th' } = Astro.props;
const t = useT(lang);
const groups = groupedHours();
const shut = closedDays();
const ZH_DAYS = ['日', '一', '二', '三', '四', '五', '六'];
const dayName = (d: number) => (lang === 'zh' ? ZH_DAYS[d] : dayNameShort(d));
---
<div class="visit">
  <div class="visit__map">
    {/* ไม่ฝัง iframe แผนที่ เพราะ iframe ตัวเดียวหนักกว่าทั้งหน้ารวมกัน
        วาดเป็นผังลายเส้นทองแทน แล้วให้ปุ่มพาไป Google Maps ของจริง */}
    <svg viewBox="0 0 400 300" role="img"
         aria-label={lang === 'zh' ? '本堂位於佛城二段路旁的位置示意圖' : 'แผนผังตำแหน่งตำหนักริมถนนพุทธมณฑลสาย ๒'}>
      <defs>
        <linearGradient id="mapbg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FBF3E3" />
          <stop offset="100%" stop-color="#F2E6CE" />
        </linearGradient>
        <radialGradient id="mapglow" cx="50%" cy="52%" r="42%">
          <stop offset="0%" stop-color="rgba(160,32,28,.16)" />
          <stop offset="100%" stop-color="rgba(160,32,28,0)" />
        </radialGradient>
      </defs>
      <rect width="400" height="300" fill="url(#mapbg)" />

      {/* ถนนซอย */}
      <g stroke="rgba(142,106,22,.20)" stroke-width="1" fill="none">
        <path d="M0 74 H400 M0 214 H400 M96 0 V300 M304 0 V300" />
      </g>

      {/* ถนนสายหลัก */}
      <path d="M200 0 V300" stroke="rgba(255,255,255,.85)" stroke-width="26" fill="none" />
      <path d="M200 0 V300" stroke="rgba(142,106,22,.5)" stroke-width="1" fill="none" stroke-dasharray="7 9" />

      <text x="216" y="34" fill="#8E6A16" font-size="11.5" letter-spacing="2.4"
            font-family="var(--mono)">{lang === 'zh' ? '佛城二段路' : 'พุทธมณฑลสาย ๒'}</text>

      {/* ตำแหน่งตำหนัก */}
      <circle cx="200" cy="156" r="46" fill="url(#mapglow)" />
      <circle cx="200" cy="156" r="21" fill="none" stroke="rgba(160,32,28,.34)" stroke-width="1" />
      <circle cx="200" cy="156" r="9" fill="#A0201C" />
      <circle cx="200" cy="156" r="3.4" fill="#F6E3B0" />
      <text x="200" y="216" text-anchor="middle" fill="#7C1512" font-size="14"
            font-family="var(--display)">{lang === 'zh' ? '本堂' : 'ตำหนัก'}</text>
    </svg>
  </div>

  <div class="visit__info panel">
    <h3>{lang === 'zh' ? site.name_zh : site.name_th}</h3>
    <p class="visit__addr">{lang === 'zh' ? site.address.full_zh : site.address.full_th}</p>

    <table class="visit__hours">
      <caption class="visit__caption">{t('hours.caption')}</caption>
      <tbody>
        {groups.map((g) => (
          <tr>
            <th scope="row">{g.days.map((d) => dayName(d)).join(' · ')}</th>
            <td class="mono">{g.open}–{g.close}</td>
          </tr>
        ))}
        {/* วันปิดต้องมีแถวของตัวเอง ไม่ใช่หายไปเฉย ๆ จากตาราง
            คนอ่านตารางแล้วไม่เห็นวันจันทร์ จะคิดว่าลืมใส่ ไม่ใช่ว่าปิด */}
        {shut.length > 0 && (
          <tr class="visit__shut">
            <th scope="row">{shut.map((d) => dayName(d)).join(' · ')}</th>
            <td>{t('hours.closed')}</td>
          </tr>
        )}
      </tbody>
    </table>
    <p class="visit__note small muted">{lang === 'zh' ? site.hours.note_zh : site.hours.note}</p>

    <div class="visit__cta">
      <a class="btn btn--gold" href={site.maps_url} target="_blank" rel="noopener">{t('cta.maps')}</a>
      <a class="btn btn--ghost" href={withLang('/visit', lang)}>{t('cta.visitDetail')}</a>
    </div>
  </div>
</div>

<style>
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  @media (max-width: 760px) { .visit { grid-template-columns: 1fr; } }

  .visit__map { background: #F2E6CE; }
  .visit__map svg { width: 100%; height: 100%; min-height: 250px; display: block; object-fit: cover; }

  .visit__info { border: 0; border-radius: 0; padding: 26px; display: flex; flex-direction: column; gap: 14px; border-left: 1px solid var(--line); }
  @media (max-width: 760px) { .visit__info { border-left: 0; border-top: 1px solid var(--line); } }
  .visit__info h3 { font-size: 20px; }
  .visit__addr { font-size: 16.5px; color: var(--ink-2); margin: 0; }

  .visit__hours { border-collapse: collapse; width: 100%; }
  .visit__caption {
    text-align: left;
    font: 600 11.5px/1.4 var(--sans);
    letter-spacing: .28em; padding-right: .28em; text-transform: uppercase;
    color: var(--gold); padding-bottom: 10px;
  }
  .visit__hours th { text-align: left; font-weight: 400; color: var(--ink-2); padding: 7px 0; font-size: 16px; border-top: 1px solid var(--line); }
  .visit__hours td { text-align: right; padding: 7px 0; font-size: 16px; font-variant-numeric: tabular-nums; border-top: 1px solid var(--line); }

  /* แถววันปิดต้องอ่านออกทันทีว่าเป็นวันหยุด ไม่ใช่เวลาที่ลืมกรอก */
  .visit__shut th, .visit__shut td { color: var(--lacquer); }
  .visit__shut td { font-weight: 600; }
  .visit__note { margin: 0; }
  .visit__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
</style>
