---
/**
 * ภาพองค์ปาง — ใช้ภาพถ่ายจริงถ้ามีในคลัง ถ้ายังไม่มีจะวาด "ตู้พระ" แทน
 *
 * ตู้พระเป็นพื้นรักเข้มขลิบทองสองชั้น อักษรจีนปิดทองอยู่กลาง
 * ทำให้ช่องที่ยังไม่มีภาพอ่านเป็นของที่ตั้งใจทำ ไม่ใช่กรอบเปล่ารอใส่รูป
 * เมื่อภาพถ่ายจริงมา ภาพจะแทนที่ตู้ในกรอบเดิม สัดส่วนไม่ขยับ
 * (ดูสเปกถ่ายภาพในพิมพ์เขียว — 3:4 แนวตั้ง ชื่อไฟล์ pang-01 … pang-33)
 */
import photos from '../data/photos.json';
import { pangNo } from '../lib/format';
import type { Lang } from '../i18n';

interface Props {
  photo: string;
  order: number;
  nameTh: string;
  nameZh: string;
  enshrined?: boolean;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  lang?: Lang;
}
const {
  photo, order, nameTh, nameZh,
  enshrined = true, sizes = '(max-width: 640px) 45vw, 300px',
  loading = 'lazy', priority = false, lang = 'th',
} = Astro.props;

const L = lang === 'zh'
  ? { waiting: '尚無照片', pending: '尚待迎請', alt: (n: string) => `${n} 造像（普陀觀音堂）`, noPhoto: (n: string) => `${n} 尚無照片` }
  : { waiting: 'รอภาพถ่าย', pending: 'กำลังอัญเชิญ', alt: (n: string) => `องค์${n} ${nameZh} ในตำหนักผู่โถวเจ้าแม่กวนอิม`, noPhoto: (n: string) => `ยังไม่มีภาพถ่ายองค์${n} ${nameZh}` };

const entry = (photos.images as Record<string, { widths: number[]; ext: string }>)[photo];
const srcset = entry
  ? entry.widths.map((w) => `/images/pang/${photo}-${w}.webp ${w}w`).join(', ')
  : null;
const uid = `pa${order}`;
---
{srcset ? (
  <img
    class="pang-art"
    src={`/images/pang/${photo}-960.webp`}
    srcset={srcset}
    sizes={sizes}
    width="900" height="1200"
    alt={L.alt(nameTh)}
    loading={priority ? 'eager' : loading}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
) : (
  <div class="pang-art pang-art--case" role="img" aria-label={L.noPhoto(nameTh)}>
    <span class="pang-case__no mono" aria-hidden="true">{pangNo(order)}</span>
    <span class="pang-case__zh han foil" aria-hidden="true">{nameZh.slice(0, 2)}</span>
    <span class="pang-case__hint" aria-hidden="true">{enshrined ? L.waiting : L.pending}</span>
  </div>
)}

<style>
  .pang-art {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--surface-2);
    display: block;
  }

  /* ตู้พระ: รักเข้มไล่เฉด ขลิบทองสองชั้น */
  .pang-art--case {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background:
      radial-gradient(78% 58% at 50% 26%, rgba(216, 169, 63, .14) 0%, transparent 64%),
      linear-gradient(178deg, #2A1015 0%, #14080A 100%);
    box-shadow: inset 0 0 0 1px rgba(242, 220, 166, .34);
    overflow: hidden;
  }
  /* ขลิบชั้นในเว้นระยะจากขอบ อย่างกรอบไม้แกะ */
  .pang-art--case::before {
    content: "";
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(242, 220, 166, .22);
    pointer-events: none;
  }
  /* เงาขอบล่างให้ดูเป็นช่องลึก ไม่ใช่แผ่นแบน */
  .pang-art--case::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgba(0, 0, 0, .42) 100%);
    pointer-events: none;
  }

  .pang-case__no {
    position: relative;
    z-index: 1;
    font-size: 12.5px;
    letter-spacing: .34em;
    padding-left: .34em;
    color: #D8A93F;
  }
  .pang-case__zh {
    position: relative;
    z-index: 1;
    font-size: clamp(40px, 6.2vw, 62px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: .06em;
    padding-left: .06em;
    text-align: center;
  }
  .pang-case__hint {
    position: relative;
    z-index: 1;
    font-size: 13px;
    letter-spacing: .04em;
    color: rgba(242, 220, 166, .48);
  }
</style>
