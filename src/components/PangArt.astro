---
/**
 * ภาพองค์ปาง — ใช้ภาพถ่ายจริงถ้ามีในคลัง ถ้ายังไม่มีจะวาดแท่นบูชาแทน
 * ที่ยอมให้ขึ้นเว็บโดยไม่มีภาพ เพราะ QR ในตำหนักและวันเปิดรอภาพไม่ได้
 * (ดูสเปกถ่ายภาพในพิมพ์เขียว — 3:4 แนวตั้ง ชื่อไฟล์ pang-01 … pang-33)
 */
import photos from '../data/photos.json';
import { pangNo } from '../lib/format';
import type { Lang } from '../i18n';

interface Props {
  photo: string;
  order: number;
  nameTh: string;
  nameZh: string;
  enshrined?: boolean;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  lang?: Lang;
}
const {
  photo, order, nameTh, nameZh,
  enshrined = true, sizes = '(max-width: 640px) 45vw, 300px',
  loading = 'lazy', priority = false, lang = 'th',
} = Astro.props;

const L = lang === 'zh'
  ? { waiting: '尚無照片', pending: '尚待迎請', alt: (n: string) => `${n} 造像（普陀觀音堂）`, noPhoto: (n: string) => `${n} 尚無照片` }
  : { waiting: 'รอภาพถ่าย', pending: 'กำลังอัญเชิญ', alt: (n: string) => `องค์${n} ${nameZh} ในตำหนักผู่โถวเจ้าแม่กวนอิม`, noPhoto: (n: string) => `ยังไม่มีภาพถ่ายองค์${n} ${nameZh}` };

const entry = (photos.images as Record<string, { widths: number[]; ext: string }>)[photo];
const srcset = entry
  ? entry.widths.map((w) => `/images/pang/${photo}-${w}.webp ${w}w`).join(', ')
  : null;
---
{srcset ? (
  <img
    class="pang-art"
    src={`/images/pang/${photo}-960.webp`}
    srcset={srcset}
    sizes={sizes}
    width="900" height="1200"
    alt={L.alt(nameTh)}
    loading={priority ? 'eager' : loading}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
) : (
  <svg class="pang-art pang-art--draft" viewBox="0 0 300 400" role="img"
       aria-label={L.noPhoto(nameTh)}>
    <defs>
      <linearGradient id={`niche-${order}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--surface)" />
        <stop offset="100%" stop-color="var(--surface-2)" />
      </linearGradient>
    </defs>
    <rect width="300" height="400" fill="var(--surface-2)" />
    {/* ซุ้มประดิษฐาน */}
    <path d="M58 348 L58 148 A92 92 0 0 1 242 148 L242 348 Z" fill={`url(#niche-${order})`} />
    <path d="M58 348 L58 148 A92 92 0 0 1 242 148 L242 348"
          fill="none" stroke="var(--gold-bright)" stroke-width="1.6" opacity=".75" />
    <path d="M68 348 L68 152 A82 82 0 0 1 232 152 L232 348"
          fill="none" stroke="var(--line-strong)" stroke-width="1" opacity=".8" />
    {/* ฐานบัว */}
    <path d="M92 348 q58 24 116 0 q-16 20 -58 20 q-42 0 -58 -20 Z"
          fill="var(--gold-soft)" stroke="var(--gold-bright)" stroke-width="1.1" opacity=".95" />
    <line x1="58" y1="348" x2="242" y2="348" stroke="var(--gold-bright)" stroke-width="1.6" opacity=".75" />
    {/* ลำดับปาง + อักษรจีน */}
    <text x="150" y="196" text-anchor="middle" class="pang-art__no">{pangNo(order)}</text>
    <text x="150" y="262" text-anchor="middle" class="pang-art__zh">{nameZh.slice(0, 2)}</text>
    <text x="150" y="316" text-anchor="middle" class="pang-art__hint">
      {enshrined ? L.waiting : L.pending}
    </text>
  </svg>
)}

<style>
  .pang-art {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--surface-2);
    display: block;
  }

  .pang-art__no {
    font-family: var(--mono);
    font-size: 22px;
    fill: var(--gold);
    letter-spacing: .22em;
  }
  .pang-art__zh {
    font-family: var(--han);
    font-size: 54px;
    font-weight: 700;
    fill: var(--gold);
    opacity: .42;
    letter-spacing: .04em;
  }
  .pang-art__hint {
    font-family: var(--sans);
    font-size: 14px;
    fill: var(--ink-3);
  }
</style>
