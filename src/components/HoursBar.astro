---
/**
 * แถบเวลาเปิด–ปิดวันนี้ + ปุ่มนำทาง
 * คนกลุ่มที่มาจาก Google มักออกภายใน 30 วินาทีถ้าไม่เจอสองอย่างนี้
 * จึงต้องอยู่บนหน้าแรกแบบเห็นทันที ไม่ใช่ซ่อนในหน้าติดต่อ
 *
 * "วันนี้" คำนวณในเบราว์เซอร์ตามเวลาไทย (เว็บเป็น HTML คงที่ จะ build ค้างไว้ไม่ได้)
 * ถ้าปิด JavaScript จะเห็นตารางรวมทั้งสัปดาห์แทน ซึ่งตอบคำถามได้เหมือนกัน
 */
import site from '../lib/site';
import { hoursSummary } from '../lib/hours';
import { useT, type Lang } from '../i18n';

interface Props { compact?: boolean; lang?: Lang }
const { compact = false, lang = 'th' } = Astro.props;
const t = useT(lang);
const weekly = JSON.stringify(site.hours.weekly);
// ข้อความสถานะส่งไปกับ DOM เพราะสคริปต์เป็น inline ธรรมดา ไม่ได้ผ่าน bundler
const labels = JSON.stringify({
  open: t('hours.openNow'),
  soon: t('hours.opensToday'),
  shut: t('hours.closedNow'),
  closed: t('hours.closedToday'),
  days: lang === 'zh'
    ? ['週日', '週一', '週二', '週三', '週四', '週五', '週六']
    : ['อา.', 'จ.', 'อ.', 'พ.', 'พฤ.', 'ศ.', 'ส.'],
});
---
<div class:list={['hours-bar', compact && 'hours-bar--compact']} data-hours={weekly} data-hours-labels={labels}>
  <div class="wrap hours-bar__inner">
    <p class="hours-bar__text">
      <span class="hours-bar__dot" data-dot aria-hidden="true"></span>
      <span data-hours-label>{t('hours.label')}</span>
      <span class="hours-bar__time mono" data-hours-time>{hoursSummary(lang)}</span>
    </p>
    <a class="btn btn--ghost hours-bar__btn" href={site.maps_url} target="_blank" rel="noopener">
      <span class="hours-bar__btn-full">{t('cta.directions')}</span>
      <span class="hours-bar__btn-short" aria-hidden="true">{t('cta.directionsShort')}</span>
      <span aria-hidden="true">›</span>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    for (const el of document.querySelectorAll('[data-hours]')) {
      var weekly, now, L;
      try {
        weekly = JSON.parse(el.dataset.hours);
        L = JSON.parse(el.dataset.hoursLabels);
        // เวลาไทยเสมอ ไม่ว่าเครื่องผู้ใช้ตั้งเขตเวลาอะไรไว้
        now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Bangkok' }));
      } catch (e) { continue; }

      var slot = weekly.find(function (s) { return s.day === now.getDay(); });
      var label = el.querySelector('[data-hours-label]');
      var time = el.querySelector('[data-hours-time]');
      var dot = el.querySelector('[data-dot]');
      if (!label || !time) continue;

      // หาวันเปิดถัดไปจริง ๆ — ตำหนักปิดวันจันทร์ ถ้าเขียนว่า "พรุ่งนี้เปิด"
      // ในเย็นวันอาทิตย์ คนจะขับรถมาเจอประตูปิด
      var nextOpen = function (from) {
        for (var i = 1; i <= 7; i++) {
          var d = (from + i) % 7;
          var s2 = weekly.find(function (s) { return s.day === d; });
          if (s2) return { day: d, slot: s2 };
        }
        return null;
      };

      if (!slot) {
        var nx = nextOpen(now.getDay());
        label.textContent = L.closed;
        time.textContent = nx ? (L.days[nx.day] + ' ' + nx.slot.open + '–' + nx.slot.close) : '';
        el.dataset.state = 'closed';
        if (dot) dot.dataset.on = 'false';
        continue;
      }

      var mins = now.getHours() * 60 + now.getMinutes();
      var toMin = function (t) { var p = t.split(':'); return +p[0] * 60 + +p[1]; };
      var open = mins >= toMin(slot.open) && mins < toMin(slot.close);

      if (open) {
        label.textContent = L.open;
        time.textContent = slot.open + '–' + slot.close;
      } else if (mins < toMin(slot.open)) {
        label.textContent = L.soon;
        time.textContent = slot.open + '–' + slot.close;
      } else {
        // ปิดแล้ว — เวลาที่แสดงต้องเป็นของวันเปิดถัดไป ไม่ใช่ของวันนี้ที่ผ่านไปแล้ว
        var nx2 = nextOpen(now.getDay());
        label.textContent = L.shut;
        time.textContent = nx2 ? (L.days[nx2.day] + ' ' + nx2.slot.open + '–' + nx2.slot.close) : '';
      }
      el.dataset.state = open ? 'open' : 'shut';
      if (dot) dot.dataset.on = open ? 'true' : 'false';
    }
  })();
</script>

<style>
  /* แถบเวลาเปิด–ปิดเป็นครีมทองอักษรชาด — เป็นข้อมูลที่คนมองหาบ่อยที่สุด
     ต้องอ่านง่ายกลางแดด ไม่ใช่แถบเข้มที่กินความสนใจไปจากภาพอาคาร */
  .hours-bar {
    background: linear-gradient(180deg, #FBF0D8 0%, #F6E7C8 100%);
    color: var(--lacquer-deep);
    border-top: 1px solid var(--gold-bright);
    border-bottom: 1px solid var(--gold-bright);
    box-shadow: inset 0 1px 0 rgba(255, 253, 246, .9), inset 0 -1px 0 rgba(160, 32, 28, .08);
  }
  .hours-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 14px;
    padding-block: 8px;
    min-height: 52px;
    flex-wrap: nowrap;
  }
  .hours-bar__text {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    max-width: none;
    /* ข้อความยาวต้องตัดบรรทัดในตัวเอง ไม่ใช่ดันปุ่มนำทางลงไปอีกแถว */
    min-width: 0;
  }
  .hours-bar__time { font-size: 17px; font-weight: 400; opacity: .92; }
  .hours-bar__dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: currentColor; opacity: .45; flex: none;
  }
  .hours-bar__dot[data-on="true"] { opacity: 1; background: #1E7A50; box-shadow: 0 0 0 4px rgba(30, 122, 80, .2); }

  .hours-bar__btn {
    background: transparent;
    flex: none;
    min-height: 40px;
    padding-inline: 14px;
    gap: 6px;
    border-color: rgba(160, 32, 28, .34);
    color: var(--lacquer-deep);
    font-size: 15.5px;
    font-weight: 500;
  }
  .hours-bar__btn-short { display: none; }
  .hours-bar__btn:hover { background: rgba(160, 32, 28, .07); border-color: var(--lacquer); color: var(--lacquer-deep); }

  .hours-bar--compact .hours-bar__inner { min-height: 52px; padding-block: 9px; }

  /* มือถือ: ยังอยู่บรรทัดเดียว ปุ่มใช้คำสั้น ไม่ดันลงไปเป็นสองแถว */
  @media (max-width: 480px) {
    .hours-bar__text { font-size: 16px; gap: 6px 8px; }
    .hours-bar__time { font-size: 15.5px; }
    .hours-bar__btn-full { display: none; }
    .hours-bar__btn-short { display: inline; }
    .hours-bar__btn { padding-inline: 12px; min-height: 38px; }
  }
</style>
