---
import site from '../lib/site';
interface Props { title: string; path: string; lang?: 'th' | 'zh' }
const { title, path, lang = 'th' } = Astro.props;
const L = lang === 'zh'
  ? { label: '分享此頁', line: 'LINE', fb: 'Facebook', copy: '複製連結', copied: '已複製', failed: '複製失敗' }
  : { label: 'ส่งต่อหน้านี้', line: 'ไลน์', fb: 'เฟซบุ๊ก', copy: 'คัดลอกลิงก์', copied: 'คัดลอกแล้ว', failed: 'คัดลอกไม่สำเร็จ' };
const url = new URL(path, site.url).href;
const line = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---
<div class="share" data-share-url={url} data-copied={L.copied} data-failed={L.failed}>
  <span class="share__label">{L.label}</span>
  <a class="share__btn" href={line} target="_blank" rel="noopener">{L.line}</a>
  <a class="share__btn" href={fb} target="_blank" rel="noopener">{L.fb}</a>
  <button class="share__btn" type="button" data-copy>{L.copy}</button>
</div>

<script is:inline>
  for (const box of document.querySelectorAll('[data-share-url]')) {
    const btn = box.querySelector('[data-copy]');
    if (!btn || !navigator.clipboard) continue;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.shareUrl);
        const was = btn.textContent;
        btn.textContent = box.dataset.copied;
        setTimeout(() => { btn.textContent = was; }, 1800);
      } catch (e) {
        btn.textContent = box.dataset.failed;
      }
    });
  }
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .share__label { font-size: 15px; color: var(--ink-3); }
  .share__btn {
    display: inline-flex; align-items: center;
    min-height: 44px; padding: 4px 16px;
    border: 1px solid var(--line-strong); border-radius: 100px;
    background: transparent; color: var(--ink);
    font: 400 15.5px var(--sans); text-decoration: none; cursor: pointer;
  }
  .share__btn:hover { border-color: var(--lacquer); color: var(--lacquer); }
</style>
