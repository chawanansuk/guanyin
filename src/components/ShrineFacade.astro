---
/**
 * ภาพลายเส้นหน้าอาคารตำหนัก
 *
 * นี่คือ "ภาพวาดลายเส้น" ไม่ใช่ภาพถ่าย — วาดตามสัดส่วนและองค์ประกอบของอาคารจริง
 * (หลังคาสองชั้นปลายงอน สันหลังคามีมังกรคู่ขนาบดวงแก้ว กิเลนที่ปลายหลังคาสองข้าง
 *  ป้ายแดงกลาง เสาคู่จารึกโคลง ประตูทองสองบาน ลายวงกลมบนผนังสองข้าง)
 * ใช้เป็นฉากหลังของฮีโร่ระหว่างที่ยังไม่มีภาพถ่ายจริง และคงไว้ได้แม้มีภาพแล้ว
 * เพราะทำหน้าที่คนละอย่างกัน — ลายเส้นบอก "รูปทรง" ภาพถ่ายบอก "ของจริง"
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg
  class:list={['facade', cls]}
  viewBox="0 0 1200 440"
  role="img"
  aria-label="ภาพลายเส้นหน้าอาคารตำหนักผู่โถวเจ้าแม่กวนอิม"
  preserveAspectRatio="xMidYMax meet"
>
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">

    <!-- ===== สันหลังคา: ดวงแก้วเปลวไฟกลาง ขนาบด้วยลายเมฆม้วน =====
         วาดเป็นลายเมฆม้วน (卷草紋) ซึ่งเป็นลายที่มีอยู่จริงบนสันหลังคา
         ไม่วาดมังกรเป็นรูปสัตว์ เพราะมังกรที่วาดไม่ดีจะอ่านเป็นการ์ตูน
         เสียมากกว่าได้ ลายม้วนให้จังหวะและความเคลื่อนไหวได้โดยไม่ต้องเสี่ยง -->
    <g stroke-width="2">
      <!-- ดวงแก้วและเปลวไฟ -->
      <circle cx="600" cy="72" r="12" />
      <path d="M600 46 q9 12 0 14 q-9-2 0-14" />
      <path d="M581 56 q5 9 11 10 M619 56 q-5 9-11 10" />

      <!-- ลายเมฆม้วนฝั่งซ้าย -->
      <path d="M578 92 q-22-4 -38-18 q-16-14 -36-10 q-20 4 -20 22" />
      <path d="M484 86 q0-11 12-12 q11-1 13 10 q1 9-9 11 q-9 1-10-6" />
      <path d="M540 66 q-10-10 -24-8 M556 78 q-14 0-22-8" />

      <!-- ลายเมฆม้วนฝั่งขวา -->
      <path d="M622 92 q22-4 38-18 q16-14 36-10 q20 4 20 22" />
      <path d="M716 86 q0-11 -12-12 q-11-1 -13 10 q-1 9 9 11 q9 1 10-6" />
      <path d="M660 66 q10-10 24-8 M644 78 q14 0 22-8" />
    </g>

    <!-- ===== ยอดจั่วปลายหลังคาสองข้าง: ปลายงอนม้วน ===== -->
    <g stroke-width="1.8">
      <path d="M300 136 q-2-18 12-22 q12-3 16 8 q3 9-7 12" />
      <path d="M321 134 q-9 1-10-7 q-1-7 7-8 q7-1 8 6 q1 6-5 9" />
      <path d="M900 136 q2-18 -12-22 q-12-3 -16 8 q-3 9 7 12" />
      <path d="M879 134 q9 1 10-7 q1-7 -7-8 q-7-1 -8 6 q-1 6 5 9" />
    </g>

    <!-- ===== หลังคาชั้นบน: สันโค้งแอ่นกลาง ===== -->
    <g stroke-width="2.4">
      <path d="M452 112 q148-30 296 0" />
      <path d="M452 112 l-10 26 M748 112 l10 26" />
      <path d="M442 138 q158-22 316 0" />
    </g>
    <!-- แถบลายใต้สันหลังคา -->
    <g stroke-width="1.2" opacity=".7">
      <path d="M456 150 h288" />
      <path d="M470 158 h260" />
    </g>

    <!-- ===== ชายคาปีกซ้าย–ขวา ปลายงอนขึ้น ===== -->
    <g stroke-width="2.4">
      <!-- ปีกซ้าย -->
      <path d="M442 166 L266 166 q-40 0 -56 -22" />
      <path d="M210 144 q-8-12 4-18" />
      <path d="M448 190 L250 190 q-36 0 -52 -20" />
      <!-- ปีกขวา -->
      <path d="M758 166 L934 166 q40 0 56 -22" />
      <path d="M990 144 q8-12 -4-18" />
      <path d="M752 190 L950 190 q36 0 52 -20" />
    </g>
    <!-- เส้นกระเบื้องบนปีก -->
    <g stroke-width="1" opacity=".55">
      <path d="M270 168 L262 188 M300 168 L294 188 M330 168 L326 188 M360 168 L358 188 M390 168 L390 188 M420 168 L422 188" />
      <path d="M930 168 L938 188 M900 168 L906 188 M870 168 L874 188 M840 168 L842 188 M810 168 L810 188 M780 168 L778 188" />
    </g>

    <!-- ===== ป้ายแดงกลาง 普陀觀音堂 ===== -->
    <g stroke-width="2.2">
      <rect x="452" y="196" width="296" height="58" rx="2" />
      <rect x="459" y="203" width="282" height="44" rx="1" stroke-width="1" opacity=".6" />
    </g>

    <!-- ===== ตัวอาคาร ===== -->
    <g stroke-width="2.2">
      <!-- ผนังและมุมอาคาร -->
      <path d="M318 254 L318 396 M882 254 L882 396" />
      <path d="M318 254 L882 254" />
      <!-- ผนังส่วนที่ร่นเข้าไปตรงกลาง -->
      <path d="M498 254 L498 396 M702 254 L702 396" stroke-width="1.2" opacity=".5" />
    </g>

    <!-- เสาคู่จารึกโคลง -->
    <g stroke-width="2">
      <rect x="486" y="258" width="20" height="138" rx="1" />
      <rect x="694" y="258" width="20" height="138" rx="1" />
    </g>

    <!-- ป้ายเล็กเหนือประตู 慈航普渡 -->
    <g stroke-width="1.6">
      <rect x="536" y="266" width="128" height="22" rx="1" />
    </g>
    <!-- แผ่นจารึกแนวตั้งสองข้างประตู -->
    <g stroke-width="1.4" opacity=".8">
      <rect x="518" y="296" width="16" height="72" rx="1" />
      <rect x="666" y="296" width="16" height="72" rx="1" />
    </g>

    <!-- ===== ประตูทองสองบาน ===== -->
    <g stroke-width="2.2">
      <rect x="544" y="298" width="112" height="98" rx="1" />
      <path d="M600 298 L600 396" stroke-width="1.4" />
    </g>
    <!-- หมุดประตู -->
    <g fill="currentColor" stroke="none" opacity=".75">
      <circle cx="560" cy="314" r="2.2" /><circle cx="576" cy="314" r="2.2" />
      <circle cx="624" cy="314" r="2.2" /><circle cx="640" cy="314" r="2.2" />
      <circle cx="560" cy="332" r="2.2" /><circle cx="576" cy="332" r="2.2" />
      <circle cx="624" cy="332" r="2.2" /><circle cx="640" cy="332" r="2.2" />
    </g>
    <!-- ห่วงจับ -->
    <g stroke-width="1.6">
      <circle cx="586" cy="352" r="7" /><circle cx="614" cy="352" r="7" />
    </g>

    <!-- ===== ลายวงกลมบนผนังสองข้าง ===== -->
    <g stroke-width="1.8">
      <circle cx="404" cy="322" r="34" />
      <circle cx="404" cy="322" r="26" stroke-width="1.1" opacity=".7" />
      <rect x="392" y="310" width="24" height="24" stroke-width="1.1" opacity=".7" />
      <circle cx="404" cy="322" r="5" />

      <circle cx="796" cy="322" r="34" />
      <circle cx="796" cy="322" r="26" stroke-width="1.1" opacity=".7" />
      <rect x="784" y="310" width="24" height="24" stroke-width="1.1" opacity=".7" />
      <circle cx="796" cy="322" r="5" />
    </g>

    <!-- ===== บันไดและลานหิน ===== -->
    <g stroke-width="1.8">
      <path d="M470 396 L730 396" />
      <path d="M452 408 L748 408" opacity=".85" />
      <path d="M430 420 L770 420" opacity=".7" />
      <path d="M120 434 L1080 434" opacity=".45" />
    </g>
  </g>
</svg>

<style>
  .facade {
    width: 100%;
    height: auto;
    display: block;
    color: var(--gold-bright);
  }
</style>
